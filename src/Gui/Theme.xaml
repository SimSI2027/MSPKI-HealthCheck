<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MSPKI Health Check theme. Palette and shapes follow docs/GUI-DESIGN.md. Pure XAML, in-box WPF only. -->

  <!-- ===== Palette ===== -->
  <Color x:Key="C.Header">#16233F</Color>
  <SolidColorBrush x:Key="B.Header" Color="#16233F"/>
  <SolidColorBrush x:Key="B.HeaderSub" Color="#B0BED6"/>
  <SolidColorBrush x:Key="B.Accent" Color="#0067B8"/>
  <SolidColorBrush x:Key="B.AccentDark" Color="#005499"/>
  <SolidColorBrush x:Key="B.AccentSoft" Color="#E2EEFC"/>
  <SolidColorBrush x:Key="B.Window" Color="#F3F5F8"/>
  <SolidColorBrush x:Key="B.Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.Border" Color="#D6DBE3"/>
  <SolidColorBrush x:Key="B.BorderStrong" Color="#9AA3B2"/>
  <SolidColorBrush x:Key="B.GridHead" Color="#2C3E60"/>
  <SolidColorBrush x:Key="B.GridAlt" Color="#F7F9FC"/>
  <SolidColorBrush x:Key="B.Select" Color="#D6E8F8"/>
  <SolidColorBrush x:Key="B.Hover" Color="#EAF1F9"/>
  <SolidColorBrush x:Key="B.Pressed" Color="#DCE6F2"/>
  <SolidColorBrush x:Key="B.Text" Color="#1F2937"/>
  <SolidColorBrush x:Key="B.Muted" Color="#5F6877"/>
  <SolidColorBrush x:Key="B.Disabled" Color="#9AA3B2"/>
  <SolidColorBrush x:Key="B.GoodBack" Color="#DFF1E4"/>
  <SolidColorBrush x:Key="B.GoodFore" Color="#166E36"/>
  <SolidColorBrush x:Key="B.WarnBack" Color="#FFF3CD"/>
  <SolidColorBrush x:Key="B.WarnFore" Color="#8A5C00"/>
  <SolidColorBrush x:Key="B.BadBack" Color="#FDE2E2"/>
  <SolidColorBrush x:Key="B.BadFore" Color="#A82020"/>
  <SolidColorBrush x:Key="B.InfoBack" Color="#E2EEFC"/>
  <SolidColorBrush x:Key="B.InfoFore" Color="#1F4F8A"/>
  <SolidColorBrush x:Key="B.AdminBack" Color="#EDE7F6"/>
  <SolidColorBrush x:Key="B.AdminFore" Color="#5E35B1"/>
  <SolidColorBrush x:Key="B.NeutralBack" Color="#EDEFF3"/>
  <SolidColorBrush x:Key="B.NeutralFore" Color="#4B5563"/>
  <SolidColorBrush x:Key="B.White" Color="#FFFFFF"/>

  <FontFamily x:Key="F.Icons">Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="F.Mono">Consolas</FontFamily>

  <!-- ===== Text styles ===== -->
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    <Setter Property="Foreground" Value="{StaticResource B.Header}"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
  </Style>
  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ===== Cards, tiles, banners ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <!-- A status pill: DataContext has Text, Tone (Good/Warn/Bad/Info/Admin/Neutral) and Glyph. Icon + text, never colour alone. -->
  <Style x:Key="PillBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource B.NeutralBack}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.NeutralFore}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource B.NeutralFore}"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Margin" Value="0,2,8,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Good">
        <Setter Property="Background" Value="{StaticResource B.GoodBack}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.GoodFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Warn">
        <Setter Property="Background" Value="{StaticResource B.WarnBack}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.WarnFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Bad">
        <Setter Property="Background" Value="{StaticResource B.BadBack}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.BadFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Info">
        <Setter Property="Background" Value="{StaticResource B.InfoBack}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.InfoFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Admin">
        <Setter Property="Background" Value="{StaticResource B.AdminBack}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.AdminFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Text}" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="PillTemplate">
    <Border Style="{StaticResource PillBorder}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,6,0"/>
        <TextBlock Text="{Binding Text}" FontFamily="Segoe UI Semibold" FontSize="12" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Tinted block (banner, status tile): DataContext has Tone. -->
  <Style x:Key="ToneBlock" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource B.NeutralBack}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.NeutralFore}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource B.NeutralFore}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Good">
        <Setter Property="Background" Value="{StaticResource B.GoodBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.GoodFore}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.GoodFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Warn">
        <Setter Property="Background" Value="{StaticResource B.WarnBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.WarnFore}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.WarnFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Bad">
        <Setter Property="Background" Value="{StaticResource B.BadBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.BadFore}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.BadFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Info">
        <Setter Property="Background" Value="{StaticResource B.InfoBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.InfoFore}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.InfoFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Admin">
        <Setter Property="Background" Value="{StaticResource B.AdminBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.AdminFore}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.AdminFore}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Window ===== -->
  <Style x:Key="AppWindow" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource B.Window}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

  <!-- ===== Focus visual (keyboard) ===== -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" Stroke="{StaticResource B.Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Buttons ===== -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Header}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Window}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Border}"/>
              <Setter Property="Foreground" Value="{StaticResource B.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource B.Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource B.White}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentDark}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.AccentDark}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Header}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="#A9C6E3"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#A9C6E3"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Flat button that fills a row (top issues, finding lists in the details pane). -->
  <Style x:Key="RowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Tinted tile that is also a button (findings by status / severity). DataContext has Tone. -->
  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Style="{StaticResource ToneBlock}" Padding="12,8" BorderThickness="1" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderThickness" Value="2"/><Setter TargetName="Bd" Property="Padding" Value="11,7"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderThickness" Value="2"/><Setter TargetName="Bd" Property="Padding" Value="11,7"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="T" Foreground="{TemplateBinding Foreground}" FontFamily="Segoe UI Semibold"><ContentPresenter/></TextBlock>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filter chip: a ToggleButton with a pill-like look. -->
  <Style x:Key="ChipToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Tick" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ToolTip ===== -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MaxWidth" Value="420"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ScrollBar (thin) and ScrollViewer ===== -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="T" Background="#B7BFCC" CornerRadius="0" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#8E99AB"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#5F6877"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{StaticResource B.GridAlt}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{StaticResource B.GridAlt}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Cursor="Arrow"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Cursor="Arrow"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== TextBox (Tag = placeholder text) ===== -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
              <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource B.Muted}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Window}"/><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Read-only block of text that can still be selected and copied. -->
  <Style x:Key="ReadBox" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Background" Value="{StaticResource B.GridAlt}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="Padding" Value="8,8"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <!-- A value that reads like a label but can be selected and copied. -->
  <Style x:Key="ValueText" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== CheckBox ===== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="18" Height="18" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
              <TextBlock x:Name="Tick" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource B.White}" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource B.Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/><Setter TargetName="Box" Property="Background" Value="{StaticResource B.Window}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ComboBox ===== -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" SnapsToDevicePixels="True">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Select}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Tg" Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
            <ContentPresenter x:Name="Cp" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
              <Border MinWidth="{Binding ActualWidth, ElementName=Tg}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" Margin="0,0,6,6">
                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/></Border.Effect>
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tg" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== GroupBox ===== -->
  <Style TargetType="GroupBox">
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="16,8">
                <ContentPresenter ContentSource="Header" TextElement.FontFamily="Segoe UI Semibold" TextElement.Foreground="{StaticResource B.Header}"/>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Expander (chevron) ===== -->
  <Style TargetType="Expander">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton x:Name="Hd" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="B" Background="Transparent" Padding="0,8">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="Chev" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource B.Muted}" Margin="0,0,8,0"/>
                      <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chev" Property="Text" Value="&#xE70D;"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header" TextElement.FontFamily="Segoe UI Semibold"/>
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ProgressBar (determinate, 4 px) ===== -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Background" Value="{StaticResource B.Border}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot">
            <Border Background="{TemplateBinding Background}"/>
            <Rectangle x:Name="PART_Track"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== TabControl ===== -->
  <Style TargetType="TabItem">
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" MinHeight="42" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.FontFamily="Segoe UI Semibold" TextElement.FontSize="13"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/><Setter Property="Foreground" Value="{StaticResource B.Header}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/><Setter Property="Foreground" Value="{StaticResource B.Header}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{StaticResource B.Window}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="16,0">
              <TabPanel IsItemsHost="True" Background="Transparent"/>
            </Border>
            <ContentPresenter ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== DataGrid ===== -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource B.GridHead}"/>
    <Setter Property="Foreground" Value="{StaticResource B.White}"/>
    <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#3C5078" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
              <DockPanel>
                <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0" Foreground="{StaticResource B.White}" Visibility="Collapsed"/>
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </DockPanel>
            </Border>
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Background="Transparent" Cursor="SizeWE" BorderThickness="0">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Background="Transparent" Cursor="SizeWE" BorderThickness="0">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A5080"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource B.Select}"/><Setter Property="Foreground" Value="{StaticResource B.Text}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="RowBackground" Value="{StaticResource B.Card}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource B.GridAlt}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- ===== ListBox (log, lists) ===== -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Select}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- ===== TreeView ===== -->
  <Style x:Key="TreeChevron" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <TextBlock x:Name="C" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="C" Property="Text" Value="&#xE70D;"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="C" Property="Foreground" Value="{StaticResource B.Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ToggleButton x:Name="Exp" Style="{StaticResource TreeChevron}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"/>
            <Border x:Name="Bd" Grid.Column="1" Background="Transparent" Padding="4,3" SnapsToDevicePixels="True">
              <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
            </Border>
            <ItemsPresenter x:Name="Items" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Items" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="Exp" Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Select}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- ===== GridSplitter ===== -->
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Border Background="Transparent"><Border Width="1" Background="{StaticResource B.BorderStrong}" HorizontalAlignment="Center" Margin="0,8"/></Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Context menu ===== -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0,4"/>
  </Style>
</ResourceDictionary>
