<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MSPKI Health Check theme. Tokens, type ramp and shapes follow docs/GUI-DESIGN.md (section 3). Pure XAML, in-box WPF only. -->

  <!-- ===== Palette ===== -->
  <Color x:Key="C.Header">#1C1F26</Color>
  <Color x:Key="C.Shadow">#000000</Color>
  <SolidColorBrush x:Key="B.Header" Color="#1C1F26"/>
  <SolidColorBrush x:Key="B.HeaderSub" Color="#AEB6C2"/>
  <SolidColorBrush x:Key="B.HeaderHover" Color="#2E333D"/>
  <SolidColorBrush x:Key="B.HeaderPressed" Color="#3A404C"/>
  <SolidColorBrush x:Key="B.CloseHover" Color="#C42B1C"/>
  <SolidColorBrush x:Key="B.Accent" Color="#0F6CBD"/>
  <SolidColorBrush x:Key="B.AccentDark" Color="#115EA3"/>
  <SolidColorBrush x:Key="B.AccentPressed" Color="#0C3B5E"/>
  <SolidColorBrush x:Key="B.AccentSoft" Color="#EBF3FC"/>
  <SolidColorBrush x:Key="B.AccentStroke" Color="#B4D6FA"/>
  <SolidColorBrush x:Key="B.Window" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="B.Nav" Color="#FAFAFA"/>
  <SolidColorBrush x:Key="B.Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.Border" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="B.Divider" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="B.Control" Color="#D1D1D1"/>
  <SolidColorBrush x:Key="B.BorderStrong" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="B.GridHead" Color="#FAFAFA"/>
  <SolidColorBrush x:Key="B.GridAlt" Color="#FAFAFA"/>
  <SolidColorBrush x:Key="B.Select" Color="#EBF3FC"/>
  <SolidColorBrush x:Key="B.Hover" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="B.SubtleHover" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="B.Pressed" Color="#E6E6E6"/>
  <SolidColorBrush x:Key="B.Text" Color="#242424"/>
  <SolidColorBrush x:Key="B.Muted" Color="#616161"/>
  <SolidColorBrush x:Key="B.Disabled" Color="#A6A6A6"/>
  <SolidColorBrush x:Key="B.DisabledBack" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="B.GoodBack" Color="#F1FAF1"/>
  <SolidColorBrush x:Key="B.GoodFore" Color="#0E700E"/>
  <SolidColorBrush x:Key="B.GoodLine" Color="#9FD89F"/>
  <SolidColorBrush x:Key="B.WarnBack" Color="#FFF8E6"/>
  <SolidColorBrush x:Key="B.WarnFore" Color="#7A4F00"/>
  <SolidColorBrush x:Key="B.WarnLine" Color="#F2CF7A"/>
  <SolidColorBrush x:Key="B.BadBack" Color="#FDF3F4"/>
  <SolidColorBrush x:Key="B.BadFore" Color="#B10E1C"/>
  <SolidColorBrush x:Key="B.BadLine" Color="#EEACB2"/>
  <SolidColorBrush x:Key="B.InfoBack" Color="#EBF3FC"/>
  <SolidColorBrush x:Key="B.InfoFore" Color="#0F548C"/>
  <SolidColorBrush x:Key="B.InfoLine" Color="#B4D6FA"/>
  <SolidColorBrush x:Key="B.AdminBack" Color="#F7F4FB"/>
  <SolidColorBrush x:Key="B.AdminFore" Color="#5C2E91"/>
  <SolidColorBrush x:Key="B.AdminLine" Color="#C6B1DE"/>
  <SolidColorBrush x:Key="B.NeutralBack" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="B.NeutralFore" Color="#424242"/>
  <SolidColorBrush x:Key="B.NeutralLine" Color="#D1D1D1"/>
  <SolidColorBrush x:Key="B.White" Color="#FFFFFF"/>

  <!-- Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets (Windows 10) as the fallback, per glyph. -->
  <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="F.Mono">Consolas</FontFamily>

  <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" Color="{StaticResource C.Shadow}"/>
  <DropShadowEffect x:Key="CardShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.06" Color="{StaticResource C.Shadow}"/>

  <!-- ===== Text styles (type ramp) ===== -->
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource B.Muted}"/>
  </Style>
  <Style x:Key="Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- A card that holds a toolbar and a list: no padding, the parts draw their own dividers. -->
  <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Background" Value="{StaticResource B.Divider}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="VDivider" TargetType="Border">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="8,0"/>
    <Setter Property="Background" Value="{StaticResource B.Control}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- A status badge: DataContext has Text, Tone (Good/Warn/Bad/Info/Admin/Neutral) and Glyph. Icon + text, never colour alone. -->
  <Style x:Key="PillBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource B.NeutralBack}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.NeutralLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource B.NeutralFore}"/>
    <Setter Property="Padding" Value="6,0,8,0"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Margin" Value="0,2,6,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Good">
        <Setter Property="Background" Value="{StaticResource B.GoodBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.GoodLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.GoodFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Warn">
        <Setter Property="Background" Value="{StaticResource B.WarnBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.WarnLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.WarnFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Bad">
        <Setter Property="Background" Value="{StaticResource B.BadBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.BadLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.BadFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Info">
        <Setter Property="Background" Value="{StaticResource B.InfoBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.InfoLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.InfoFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Admin">
        <Setter Property="Background" Value="{StaticResource B.AdminBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.AdminLine}"/><Setter Property="TextElement.Foreground" Value="{StaticResource B.AdminFore}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Text}" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="PillTemplate">
    <Border Style="{StaticResource PillBorder}" ToolTip="{Binding Text}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,5,0"/>
        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- Tinted block (health banner, notices): DataContext has Tone. -->
  <Style x:Key="ToneBlock" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource B.NeutralBack}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.NeutralLine}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Good">
        <Setter Property="Background" Value="{StaticResource B.GoodBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.GoodLine}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Warn">
        <Setter Property="Background" Value="{StaticResource B.WarnBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.WarnLine}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Bad">
        <Setter Property="Background" Value="{StaticResource B.BadBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.BadLine}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Info">
        <Setter Property="Background" Value="{StaticResource B.InfoBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.InfoLine}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Admin">
        <Setter Property="Background" Value="{StaticResource B.AdminBack}"/><Setter Property="BorderBrush" Value="{StaticResource B.AdminLine}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- Foreground in the tone of the DataContext (icons in banners and tiles). -->
  <Style x:Key="ToneGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
    <Setter Property="Foreground" Value="{StaticResource B.NeutralFore}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter Property="Foreground" Value="{StaticResource B.GoodFore}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource B.WarnFore}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource B.BadFore}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Foreground" Value="{StaticResource B.InfoFore}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Admin"><Setter Property="Foreground" Value="{StaticResource B.AdminFore}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- A 4 px stripe in the tone of the DataContext (left edge of tiles). -->
  <Style x:Key="ToneStripe" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource B.NeutralLine}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter Property="Background" Value="{StaticResource B.GoodFore}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Background" Value="#C98A00"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter Property="Background" Value="{StaticResource B.BadFore}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Background" Value="{StaticResource B.Accent}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Admin"><Setter Property="Background" Value="{StaticResource B.AdminFore}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Neutral"><Setter Property="Background" Value="#9E9E9E"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Window ===== -->
  <Style x:Key="AppWindow" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource B.Window}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Header}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ===== Focus visual (keyboard): a 2 px dark ring just outside the control ===== -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" Stroke="#1B1B1B" StrokeThickness="2" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusRingInset">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" Stroke="#1B1B1B" StrokeThickness="2" RadiusX="4" RadiusY="4" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusRingLight">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" Stroke="#FFFFFF" StrokeThickness="2" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Buttons ===== -->
  <!-- Secondary (default): white, hairline control stroke. -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Control}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/><Setter TargetName="Bd" Property="BorderBrush" Value="#C7C7C7"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.DisabledBack}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Border}"/>
              <Setter Property="Foreground" Value="{StaticResource B.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Primary: the one accent-filled action on a screen. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource B.Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource B.White}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentDark}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.AccentDark}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentPressed}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.AccentPressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.DisabledBack}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Border}"/>
              <Setter Property="Foreground" Value="{StaticResource B.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Subtle: transparent until hovered (command bar, pane toolbars). -->
  <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SubtleHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Icon in a subtle/secondary button: accent coloured, grey when disabled. -->
  <Style x:Key="CmdGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
    <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- Caption buttons of the custom title bar. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Foreground" Value="{StaticResource B.White}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingLight}"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <TextBlock x:Name="G" Text="{TemplateBinding Content}" FontFamily="{StaticResource F.Icons}" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.HeaderHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.HeaderPressed}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource F.Icons}" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.CloseHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#A52317"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Flat button that fills a row (top issues, finding lists in the details pane). -->
  <Style x:Key="RowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Divider}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Pressed}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Count tile that is also a button (findings by status / severity). DataContext has Tone. -->
  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True" ClipToBounds="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}"/><Setter TargetName="Bd" Property="Background" Value="#FCFCFC"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="0,2">
            <TextBlock x:Name="T" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"><ContentPresenter/></TextBlock>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/><Setter Property="Foreground" Value="{StaticResource B.AccentDark}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filter chip: a rounded ToggleButton; checked = accent tint, accent stroke and a tick. -->
  <Style x:Key="ChipToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Control}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0,12,0"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="16" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Tick" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource B.Accent}" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ToolTip ===== -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Control}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MaxWidth" Value="420"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ScrollBar (thin, rounded thumb) and ScrollViewer ===== -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="T" Background="#C2C2C2" CornerRadius="3" Margin="3"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#9E9E9E"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#757575"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Cursor="Arrow"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Cursor="Arrow"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== TextBox (Tag = placeholder text). Fluent input: hairline border, darker bottom edge, accent bottom on focus. ===== -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Control}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
              <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#707070" Margin="12,0,10,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
              <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Background="{StaticResource B.BorderStrong}" CornerRadius="0,0,4,4" Margin="0,0,0,-1"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#C7C7C7"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Line" Property="Background" Value="{StaticResource B.Accent}"/><Setter TargetName="Line" Property="Height" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.DisabledBack}"/><Setter TargetName="Line" Property="Background" Value="{StaticResource B.Border}"/><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
            <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/><Setter TargetName="Line" Property="Background" Value="{StaticResource B.Control}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Search box: a TextBox with a magnifier glyph on the left. -->
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="32,0,10,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
              <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="#707070" Margin="34,0,10,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
              <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Background="{StaticResource B.BorderStrong}" Margin="0,0,0,-1"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#C7C7C7"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Line" Property="Background" Value="{StaticResource B.Accent}"/><Setter TargetName="Line" Property="Height" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.DisabledBack}"/><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Read-only block of text that can still be selected and copied (evidence). -->
  <Style x:Key="ReadBox" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Background" Value="{StaticResource B.Hover}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A value that reads like a label but can be selected and copied. -->
  <Style x:Key="ValueText" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Height" Value="Auto"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== CheckBox ===== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" Background="{StaticResource B.Card}" BorderBrush="#616161" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
              <TextBlock x:Name="Tick" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource B.White}" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource B.SubtleHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource B.Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Control}"/><Setter TargetName="Box" Property="Background" Value="{StaticResource B.DisabledBack}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A toggle switch (options): same CheckBox semantics, switch look. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="40" Height="20" VerticalAlignment="Center">
              <Border x:Name="Track" CornerRadius="10" Background="{StaticResource B.Card}" BorderBrush="#616161" BorderThickness="1"/>
              <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#616161" HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Grid>
            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource B.Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource B.White}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Control}"/><Setter TargetName="Knob" Property="Fill" Value="{StaticResource B.Control}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ComboBox ===== -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Control}" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource B.BorderStrong}" Margin="0,0,0,-1"/>
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="12" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="4,1" CornerRadius="4" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource B.Accent}" HorizontalAlignment="Left" Margin="-8,0,0,0" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SubtleHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Select}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Tg" Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
            <ContentPresenter x:Name="Cp" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
              <Border MinWidth="{Binding ActualWidth, ElementName=Tg}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Control}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,12" Padding="0,4" Effect="{StaticResource PopupShadow}">
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filter drop-down that names itself: "Severity: All". Tag = the label. -->
  <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Tg" Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
            <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="11,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource B.Muted}"/>
              <TextBlock Text=": " Foreground="{StaticResource B.Muted}"/>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.FontWeight="SemiBold"/>
            </StackPanel>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
              <Border MinWidth="{Binding ActualWidth, ElementName=Tg}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Control}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,12" Padding="0,4" Effect="{StaticResource PopupShadow}">
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== GroupBox ===== -->
  <Style TargetType="GroupBox">
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1" Padding="16,10">
                <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"/>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Expander (chevron on the left) ===== -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton x:Name="Hd" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRingInset}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="B" Background="Transparent" Padding="4,6" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="Chev" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,0,8,0"/>
                      <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chev" Property="Text" Value="&#xE70D;"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource B.SubtleHover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold"/>
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== ProgressBar (determinate, 3 px) ===== -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="3"/>
    <Setter Property="Background" Value="{StaticResource B.AccentSoft}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="TemplateRoot">
            <Border Background="{TemplateBinding Background}"/>
            <Rectangle x:Name="PART_Track"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== TabControl: the pages. The tab strip is hidden; the navigation pane (NavList) selects the page. ===== -->
  <Style TargetType="TabItem">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem"><ContentPresenter ContentSource="Header"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <TabPanel IsItemsHost="True" Visibility="Collapsed"/>
            <ContentPresenter ContentSource="SelectedContent"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Navigation pane items ===== -->
  <Style x:Key="NavItem" TargetType="ListBoxItem">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="8,2"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource B.Accent}" HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Collapsed"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SubtleHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EBEBEB"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== DataGrid ===== -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource B.GridHead}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,0,8,0"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
              <DockPanel>
                <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Style="{StaticResource Glyph}" FontSize="10" Margin="6,0,0,0" Foreground="{StaticResource B.Muted}" Visibility="Collapsed"/>
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </DockPanel>
            </Border>
            <Border Width="1" Height="16" HorizontalAlignment="Right" Background="{StaticResource B.Divider}" VerticalAlignment="Center"/>
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
            </Thumb>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="Arrow" Property="Text" Value="&#xE70E;"/><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SubtleHover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="12,0,8,0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Text}"/><Setter Property="Background" Value="Transparent"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
            <Grid>
              <SelectiveScrollingGrid>
                <SelectiveScrollingGrid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></SelectiveScrollingGrid.ColumnDefinitions>
                <SelectiveScrollingGrid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></SelectiveScrollingGrid.RowDefinitions>
                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"/>
                <DataGridRowHeader Grid.RowSpan="2" Visibility="Collapsed"/>
              </SelectiveScrollingGrid>
              <Border x:Name="Mark" Width="3" HorizontalAlignment="Left" Background="{StaticResource B.Accent}" Margin="0,6" CornerRadius="1.5" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DGR_Border" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="DGR_Border" Property="Background" Value="{StaticResource B.Select}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DGR_Border" Property="BorderBrush" Value="{StaticResource B.AccentStroke}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="RowBackground" Value="{StaticResource B.Card}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="CanUserReorderColumns" Value="False"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
  </Style>

  <!-- ===== ListBox (log) ===== -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="16,2"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Select}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- ===== TreeView ===== -->
  <Style x:Key="TreeChevron" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <TextBlock x:Name="C" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="C" Property="Text" Value="&#xE70D;"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="C" Property="Foreground" Value="{StaticResource B.Text}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ToggleButton x:Name="Exp" Style="{StaticResource TreeChevron}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"/>
            <Border x:Name="Bd" Grid.Column="1" Background="Transparent" Padding="6,0" MinHeight="32" CornerRadius="4" SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource B.Accent}" HorizontalAlignment="Left" Margin="-6,0,0,0" Visibility="Collapsed"/>
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ItemsPresenter x:Name="Items" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Items" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="Exp" Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Select}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsKeyboardFocused" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#1B1B1B"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <!-- ===== GridSplitter (a 1 px line with a wider grab area) ===== -->
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="SizeWE"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Border Background="Transparent">
            <Border Width="4" Height="32" CornerRadius="2" Background="#C7C7C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Context menu ===== -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource B.Card}"/>
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource B.Control}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="220">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter x:Name="Ic" ContentSource="Icon" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource F.Icons}" TextElement.FontSize="14" TextElement.Foreground="{StaticResource B.Muted}"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource B.Muted}" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.SubtleHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource B.Disabled}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
