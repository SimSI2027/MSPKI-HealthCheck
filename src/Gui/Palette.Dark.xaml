<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark palette: the same keys as Palette.Light.xaml. Data only. Surfaces are near-neutral greys with a slight blue cast; status colours are
       lighter tints on dark tinted backs; the accent is a light blue with dark text on it. tests/GuiTheme.Tests.ps1 checks every key and the
       WCAG AA pairs (text 4.5:1, data colours and control borders 3:1). -->
  <SolidColorBrush x:Key="B.Header" Color="#121418"/>
  <SolidColorBrush x:Key="B.HeaderSub" Color="#AEB6C2"/>
  <SolidColorBrush x:Key="B.HeaderHover" Color="#262A31"/>
  <SolidColorBrush x:Key="B.HeaderPressed" Color="#30353D"/>
  <SolidColorBrush x:Key="B.CloseHover" Color="#C42B1C"/>
  <SolidColorBrush x:Key="B.Accent" Color="#5AAEEB"/>
  <SolidColorBrush x:Key="B.AccentDark" Color="#7DC0F0"/>
  <SolidColorBrush x:Key="B.AccentPressed" Color="#A3D3F5"/>
  <SolidColorBrush x:Key="B.AccentSoft" Color="#1D3247"/>
  <SolidColorBrush x:Key="B.AccentStroke" Color="#2F5B80"/>
  <SolidColorBrush x:Key="B.Window" Color="#1A1C20"/>
  <SolidColorBrush x:Key="B.Nav" Color="#1F2125"/>
  <SolidColorBrush x:Key="B.Card" Color="#25282D"/>
  <SolidColorBrush x:Key="B.Border" Color="#383C43"/>
  <SolidColorBrush x:Key="B.Divider" Color="#31343A"/>
  <SolidColorBrush x:Key="B.Control" Color="#4A4F57"/>
  <SolidColorBrush x:Key="B.BorderStrong" Color="#868C95"/>
  <SolidColorBrush x:Key="B.GridHead" Color="#22252A"/>
  <SolidColorBrush x:Key="B.GridAlt" Color="#292C31"/>
  <SolidColorBrush x:Key="B.Select" Color="#1D3247"/>
  <SolidColorBrush x:Key="B.Hover" Color="#2D3036"/>
  <SolidColorBrush x:Key="B.SubtleHover" Color="#30333A"/>
  <SolidColorBrush x:Key="B.Pressed" Color="#383C43"/>
  <SolidColorBrush x:Key="B.Text" Color="#ECEDEF"/>
  <SolidColorBrush x:Key="B.Muted" Color="#A7ADB6"/>
  <SolidColorBrush x:Key="B.Disabled" Color="#6B7079"/>
  <SolidColorBrush x:Key="B.DisabledBack" Color="#2A2D32"/>
  <SolidColorBrush x:Key="B.GoodBack" Color="#18301C"/>
  <SolidColorBrush x:Key="B.GoodFore" Color="#8FD694"/>
  <SolidColorBrush x:Key="B.GoodLine" Color="#2F6B38"/>
  <SolidColorBrush x:Key="B.WarnBack" Color="#352A12"/>
  <SolidColorBrush x:Key="B.WarnFore" Color="#F0C36B"/>
  <SolidColorBrush x:Key="B.WarnLine" Color="#77591E"/>
  <SolidColorBrush x:Key="B.BadBack" Color="#3A1C20"/>
  <SolidColorBrush x:Key="B.BadFore" Color="#FF9FA6"/>
  <SolidColorBrush x:Key="B.BadLine" Color="#80363E"/>
  <SolidColorBrush x:Key="B.InfoBack" Color="#18304A"/>
  <SolidColorBrush x:Key="B.InfoFore" Color="#8EC6F5"/>
  <SolidColorBrush x:Key="B.InfoLine" Color="#2F5B80"/>
  <SolidColorBrush x:Key="B.AdminBack" Color="#2A2140"/>
  <SolidColorBrush x:Key="B.AdminFore" Color="#C9B2EF"/>
  <SolidColorBrush x:Key="B.AdminLine" Color="#5A4786"/>
  <SolidColorBrush x:Key="B.NeutralBack" Color="#2C2F34"/>
  <SolidColorBrush x:Key="B.NeutralFore" Color="#D2D5DA"/>
  <SolidColorBrush x:Key="B.NeutralLine" Color="#4A4F57"/>
  <SolidColorBrush x:Key="B.OnAccent" Color="#0A1724"/>
  <!-- Data colours (score ring, area bars, map): mid-light tones with at least 3:1 against the dark card. -->
  <SolidColorBrush x:Key="B.GoodData" Color="#4FB35A"/>
  <SolidColorBrush x:Key="B.WarnData" Color="#E0A23A"/>
  <SolidColorBrush x:Key="B.BadData" Color="#EF6B72"/>
  <SolidColorBrush x:Key="B.AdminData" Color="#A88BDB"/>
  <SolidColorBrush x:Key="B.NeutralData" Color="#868C95"/>
  <SolidColorBrush x:Key="B.InfoData" Color="#5AAEEB"/>
  <SolidColorBrush x:Key="B.OnHeader" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.OnData" Color="#101215"/>
  <!-- Focus ring, hover lines, scroll bars, check boxes, navigation selection, count badges, header outlines. -->
  <SolidColorBrush x:Key="B.FocusRing" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.FocusRingInner" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="B.HoverLine" Color="#5A5F68"/>
  <SolidColorBrush x:Key="B.CloseHoverPressed" Color="#A52317"/>
  <SolidColorBrush x:Key="B.FieldHover" Color="#2C2F34"/>
  <SolidColorBrush x:Key="B.Scroll" Color="#4E535B"/>
  <SolidColorBrush x:Key="B.ScrollHover" Color="#6B7079"/>
  <SolidColorBrush x:Key="B.ScrollDrag" Color="#868C95"/>
  <SolidColorBrush x:Key="B.ControlStrong" Color="#A7ADB6"/>
  <SolidColorBrush x:Key="B.NavSelect" Color="#2E3137"/>
  <SolidColorBrush x:Key="B.Badge" Color="#3A3E45"/>
  <SolidColorBrush x:Key="B.HeaderLine" Color="#4A5160"/>
</ResourceDictionary>
