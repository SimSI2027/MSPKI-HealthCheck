<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSPKI Health Check" Width="1360" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource AppWindow}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis"/>

      <!-- ===== Details pane: one finding ===== -->
      <DataTemplate x:Key="FindingPane">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16,12,16,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
              <Button Tag="Back" Style="{StaticResource LinkButton}" Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Back to the item"/></StackPanel>
              </Button>
              <DockPanel>
                <Button DockPanel.Dock="Right" Tag="Copy" ToolTip="Copy every field of this finding to the clipboard" Padding="12,0" VerticalAlignment="Top" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,8,0"/><TextBlock Text="Copy"/></StackPanel>
                </Button>
                <WrapPanel>
                  <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                  <ContentPresenter Content="{Binding SeverityPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                  <ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/>
                </WrapPanel>
              </DockPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Id}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,16,16">
              <TextBlock Text="WHAT WAS FOUND" Style="{StaticResource Label}" Margin="0,0,0,4"/>
              <TextBox Text="{Binding Message, Mode=OneWay}" Style="{StaticResource ValueText}" FontSize="14"/>

              <StackPanel Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="SUGGESTED ACTION" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <Border Background="{StaticResource B.InfoBack}" BorderBrush="{StaticResource B.InfoFore}" BorderThickness="3,0,0,0" Padding="12,8">
                  <TextBox Text="{Binding Remediation, Mode=OneWay}" Style="{StaticResource ValueText}" Foreground="{StaticResource B.InfoFore}"/>
                </Border>
              </StackPanel>

              <TextBlock Text="CHECKED LAYERS" Style="{StaticResource Label}" Margin="0,16,0,4"/>
              <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate><ContentPresenter Content="{Binding Pill}" ContentTemplate="{StaticResource PillTemplate}"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="DETAILS" Style="{StaticResource Label}" Margin="0,16,0,4"/>
              <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,2">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}"/>
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="SOURCES" Style="{StaticResource Label}" Margin="0,16,0,4"/>
              <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="EVIDENCE" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Evidence, Mode=OneWay}" Style="{StaticResource ReadBox}" MaxHeight="320"/>
              </StackPanel>

              <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <TextBlock Text="NOTES" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, Mode=OneWay}" Style="{StaticResource ValueText}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </DataTemplate>

      <!-- ===== Details pane: one Discovery Map item ===== -->
      <DataTemplate x:Key="NodePane">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="16,12,16,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Tag="Copy" ToolTip="Copy this item to the clipboard" Padding="12,0" VerticalAlignment="Top" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,8,0"/><TextBlock Text="Copy"/></StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                  <TextBlock Style="{StaticResource Glyph}" Text="{Binding TypeGlyph}" FontSize="16" Foreground="{StaticResource B.Accent}" Margin="0,2,8,0"/>
                  <TextBlock Text="{Binding TypeText}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,6,0,6"/>
              <WrapPanel>
                <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                <ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/>
              </WrapPanel>
              <TextBlock Text="{Binding BelowText}" Visibility="{Binding HasBelow, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource B.BadFore}" FontStyle="Italic" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,16,16">
              <TextBlock Text="DETAILS" Style="{StaticResource Label}" Margin="0,0,0,4"/>
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,0,4"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding NoDetailText}" Style="{StaticResource Muted}"/>

              <TextBlock Text="SOURCES" Style="{StaticResource Label}" Margin="0,16,0,4"/>
              <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,2"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Margin="0,16,0,4" Style="{StaticResource Label}"><Run Text="FINDINGS FOR THIS ITEM ("/><Run Text="{Binding FindingCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
              <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource RowButton}" Tag="{Binding Id}" ToolTip="Show the full finding">
                      <StackPanel>
                        <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="No finding is attached to this item." Style="{StaticResource Muted}" Visibility="{Binding NoFindings, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </DataTemplate>

      <DataTemplate x:Key="EmptyPane">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="320">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="36" Foreground="{StaticResource B.BorderStrong}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" TextAlignment="Center"/>
        </StackPanel>
      </DataTemplate>

      <!-- The pane host switches its template on the Kind of what it shows. -->
      <Style x:Key="PaneHost" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ContentTemplate" Value="{StaticResource EmptyPane}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Finding"><Setter Property="ContentTemplate" Value="{StaticResource FindingPane}"/></DataTrigger>
          <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Node"><Setter Property="ContentTemplate" Value="{StaticResource NodePane}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ===== Summary templates ===== -->
      <DataTemplate x:Key="KpiTile">
        <Border Style="{StaticResource Card}" Margin="0,0,16,16" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" Background="{StaticResource B.AccentSoft}" VerticalAlignment="Top" Margin="0,0,14,0">
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="20" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Value}" FontSize="26" FontFamily="Segoe UI Semibold" Foreground="{StaticResource B.Header}"/>
              <TextBlock Text="{Binding Label}" FontFamily="Segoe UI Semibold" Foreground="{StaticResource B.Header}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Sub}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="CountTile">
        <Button Style="{StaticResource TileButton}" Tag="{Binding Tag}" Margin="0,0,12,12" MinWidth="136"
                ToolTip="Show these findings in the Findings tab" AutomationProperties.Name="{Binding Label}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding Label}" FontFamily="Segoe UI Semibold" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="{Binding Count}" FontSize="24" FontFamily="Segoe UI Semibold" Margin="0,2,0,0"/>
          </StackPanel>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="CaCard">
        <Border Style="{StaticResource Card}" Margin="0,0,16,16" MinWidth="440" MaxWidth="620">
          <StackPanel>
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Right" Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top" Margin="12,0,0,0"/>
              <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="24" Foreground="{StaticResource B.Accent}" Margin="0,0,12,0" VerticalAlignment="Top"/>
              <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Host}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Role}" FontFamily="Segoe UI Semibold" Margin="0,10,0,0"/>
            <WrapPanel Margin="0,6,0,0">
              <ContentPresenter Content="{Binding ExpiryPill}" ContentTemplate="{StaticResource PillTemplate}"/>
              <ContentPresenter Content="{Binding CrlPill}" ContentTemplate="{StaticResource PillTemplate}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Certificate}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Facts}" Style="{StaticResource Small}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </DataTemplate>

      <DataTemplate x:Key="TopIssue">
        <Button Style="{StaticResource RowButton}" Tag="{Binding Id}" ToolTip="Open this finding in the Findings tab">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource B.Muted}" Margin="8,4,0,0" VerticalAlignment="Top"/>
          </Grid>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="CoverageRow">
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ContentPresenter Content="{Binding Pill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Method}" FontFamily="Segoe UI Semibold"/>
            <TextBlock Text="{Binding Reason}" Style="{StaticResource Small}"/>
          </StackPanel>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="HeaderFact">
        <StackPanel Margin="0,0,28,0">
          <TextBlock Text="{Binding Label}" FontSize="10" FontFamily="Segoe UI Semibold" Foreground="{StaticResource B.HeaderSub}"/>
          <TextBlock Text="{Binding Value}" Foreground="{StaticResource B.White}" FontFamily="Segoe UI Semibold" TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding Value}"/>
        </StackPanel>
      </DataTemplate>

      <!-- Run Log row: a level tag in text plus a colour. -->
      <DataTemplate x:Key="LogRow">
        <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{StaticResource B.BadFore}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource B.WarnFore}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Debug"><Setter Property="Foreground" Value="{StaticResource B.Muted}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="{Binding Text, Mode=OneWay}"/>
        </TextBlock>
      </DataTemplate>

      <HierarchicalDataTemplate x:Key="MapNode" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Margin="0,1">
          <TextBlock Style="{StaticResource Glyph}" Text="{Binding TypeGlyph}" FontSize="14" Foreground="{StaticResource B.Accent}" Margin="0,0,8,0" ToolTip="{Binding TypeText}"/>
          <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}" Margin="0,0,0,0"/>
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip="{Binding Label}" Margin="0,0,8,0"/>
          <ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/>
          <TextBlock Text="{Binding BelowText}" Foreground="{StaticResource B.BadFore}" FontStyle="Italic" VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>
      </HierarchicalDataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <Border Grid.Row="0" Background="{StaticResource B.Header}" Padding="24,12,24,8">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#2C3E60" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,6,0,0">
          <ItemsControl x:Name="HdrContext" ItemTemplate="{StaticResource HeaderFact}" IsTabStop="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </Border>
        <ContentPresenter x:Name="HdrBadge" DockPanel.Dock="Right" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top" Margin="16,0,0,0"/>
        <StackPanel Orientation="Horizontal">
          <Border Width="44" Height="44" Background="{StaticResource B.Accent}" Margin="0,0,14,0">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="24" Foreground="{StaticResource B.White}" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="MSPKI Health Check" Style="{StaticResource H1}" Foreground="{StaticResource B.White}"/>
              <TextBlock x:Name="HdrVersion" Foreground="{StaticResource B.HeaderSub}" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
            </StackPanel>
            <TextBlock Foreground="{StaticResource B.HeaderSub}" Text="Read-only health check of Active Directory Certificate Services. Nothing is changed."/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Toolbar ===== -->
    <Border Grid.Row="1" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="24,6">
      <WrapPanel>
        <Button x:Name="BtnRun" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="104" ToolTip="Start a new health check (F5). It only reads; nothing is changed.">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0"/><TextBlock Text="Run"/></StackPanel>
        </Button>
        <Button x:Name="BtnCancel" Margin="0,0,24,0" IsEnabled="False" ToolTip="Stop the run at the next step (Esc). Partial results are still saved.">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" Margin="0,0,8,0"/><TextBlock Text="Cancel"/></StackPanel>
        </Button>
        <Button x:Name="BtnOpenResults" Margin="0,0,8,0" ToolTip="Look at an earlier run without scanning anything (Ctrl+O).">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,8,0"/><TextBlock Text="Open results"/></StackPanel>
        </Button>
        <Button x:Name="BtnOpenReport" Margin="0,0,8,0" IsEnabled="False" ToolTip="Open the HTML report of this run in the browser.">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" Margin="0,0,8,0"/><TextBlock Text="Open report"/></StackPanel>
        </Button>
        <Button x:Name="BtnOpenFolder" Margin="0,0,8,0" ToolTip="Open the folder that holds the results of this run.">
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" Margin="0,0,8,0"/><TextBlock Text="Open folder"/></StackPanel>
        </Button>
      </WrapPanel>
    </Border>

    <!-- ===== Options ===== -->
    <Border Grid.Row="2" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="24,0">
      <Expander x:Name="ExpOptions" IsExpanded="False">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Options"/>
            <TextBlock x:Name="TxtOptionsSummary" Style="{StaticResource Small}" Margin="12,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Expander.Header>
        <Grid Margin="20,4,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Timeout per probe (seconds)" VerticalAlignment="Center" Margin="0,0,0,12"/>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="TxtTimeout" Width="64" Text="5" ToolTip="Whole number from 1 to 120."/>
            <TextBlock Text="1 to 120. Every network call stops after this time." Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="Network" VerticalAlignment="Top" Margin="0,0,0,12"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
            <CheckBox x:Name="ChkSkipNetwork" Content="Skip network (read Active Directory only)" ToolTip="Do not contact any CA or web server. Only Active Directory is read."/>
            <TextBlock Text="No CA, web server or other host is contacted." Style="{StaticResource Small}" Margin="26,2,0,0"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="Proxy" VerticalAlignment="Top" Margin="0,0,0,12"/>
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
            <CheckBox x:Name="ChkProxy" Content="Use the system proxy for web probes" ToolTip="Off by default: web probes connect directly, without credentials."/>
            <TextBlock Text="Off by default: web probes connect directly and never send credentials." Style="{StaticResource Small}" Margin="26,2,0,0"/>
          </StackPanel>
          <TextBlock Grid.Row="3" Text="NDES" VerticalAlignment="Top" Margin="0,0,0,12"/>
          <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
            <CheckBox x:Name="ChkNdesAdmin" Content="Also probe the NDES admin page (opt-in)" ToolTip="Sends one anonymous request to the NDES admin page."/>
            <TextBlock Text="One anonymous request. If that page is wrongly open it creates a challenge password on the server, so this is off by default." Style="{StaticResource Small}" Margin="26,2,0,0"/>
          </StackPanel>
          <TextBlock Grid.Row="4" Text="Output folder" VerticalAlignment="Center"/>
          <TextBox x:Name="TxtOutput" Grid.Row="4" Grid.Column="1" IsReadOnly="True" Background="{StaticResource B.Window}" MaxWidth="720" HorizontalAlignment="Left" Width="720"/>
        </Grid>
      </Expander>
    </Border>

    <ProgressBar x:Name="Progress" Grid.Row="3" Minimum="0" Maximum="100" Value="0" Visibility="Hidden"/>

    <!-- ===== Tabs ===== -->
    <TabControl x:Name="Tabs" Grid.Row="4">
      <!-- Summary -->
      <TabItem x:Name="TabSummary" ToolTip="Ctrl+1">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,8,0"/><TextBlock Text="Summary"/></StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <!-- Welcome state: before the first run -->
            <StackPanel x:Name="PanelWelcome" Margin="24" MaxWidth="820" HorizontalAlignment="Center">
              <Border Style="{StaticResource Card}" Padding="32">
                <StackPanel>
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="40" Foreground="{StaticResource B.Accent}" Margin="0,0,0,12"/>
                  <TextBlock Text="Welcome to the MSPKI Health Check" Style="{StaticResource H1}" Foreground="{StaticResource B.Header}"/>
                  <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,20" Text="A read-only check of Microsoft Active Directory Certificate Services. It finds your CAs, templates and endpoints by itself: there is nothing to configure."/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="1" FontSize="18" FontFamily="Segoe UI Semibold" Foreground="{StaticResource B.Accent}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2,0,12" TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold" Text="Discovery."/><Run Text=" Reads the Public Key Services in Active Directory, then asks each CA about itself."/></TextBlock>
                    <TextBlock Grid.Row="1" Text="2" FontSize="18" FontFamily="Segoe UI Semibold" Foreground="{StaticResource B.Accent}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,12" TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold" Text="Checks."/><Run Text=" Tests only the CRL, AIA, OCSP and enrollment addresses that the CAs and certificates themselves name (anonymous requests, no scanning)."/></TextBlock>
                    <TextBlock Grid.Row="2" Text="3" FontSize="18" FontFamily="Segoe UI Semibold" Foreground="{StaticResource B.Accent}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2,0,0" TextWrapping="Wrap"><Run FontFamily="Segoe UI Semibold" Text="Report."/><Run Text=" Every finding shows its sources, its evidence and how sure the tool is. Files are written to the output folder only."/></TextBlock>
                  </Grid>
                  <Border Background="{StaticResource B.Window}" Padding="12,8" Margin="0,16,0,0">
                    <TextBlock x:Name="TxtWelcomeContext" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                  </Border>
                  <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button x:Name="BtnWelcomeRun" Style="{StaticResource PrimaryButton}" MinWidth="148" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0"/><TextBlock Text="Run health check"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnWelcomeOpen">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,8,0"/><TextBlock Text="Open an earlier results.json"/></StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Results -->
            <StackPanel x:Name="PanelResults" Margin="24" Visibility="Collapsed">
              <Border x:Name="Banner" Style="{StaticResource ToneBlock}" Padding="20,16" Margin="0,0,0,16">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Margin="24,0,0,0" MinWidth="200" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerMeta1" FontSize="12" TextAlignment="Right"/>
                    <TextBlock x:Name="BannerMeta2" FontSize="12" TextAlignment="Right"/>
                    <TextBlock x:Name="BannerMeta3" FontSize="12" TextAlignment="Right"/>
                  </StackPanel>
                  <TextBlock x:Name="BannerGlyph" DockPanel.Dock="Left" Style="{StaticResource Glyph}" FontSize="34" Margin="0,0,16,0" VerticalAlignment="Center"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BannerTitle" FontSize="20" FontFamily="Segoe UI Semibold"/>
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <TextBlock x:Name="TxtNote" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,16" Style="{StaticResource Muted}"/>

              <ItemsControl x:Name="KpiList" ItemTemplate="{StaticResource KpiTile}" Margin="0,0,-16,0" IsTabStop="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>

              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock x:Name="TxtTotal" Style="{StaticResource H2}" Text="Findings"/>
                  <TextBlock Text="Select a tile to see those findings." Style="{StaticResource Small}" Margin="0,2,0,12"/>
                  <TextBlock Text="BY STATUS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                  <ItemsControl x:Name="TileList" ItemTemplate="{StaticResource CountTile}" IsTabStop="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock Text="BY SEVERITY" Style="{StaticResource Label}" Margin="0,4,0,6"/>
                  <ItemsControl x:Name="SevTileList" ItemTemplate="{StaticResource CountTile}" IsTabStop="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <TextBlock x:Name="TxtNoSeverity" Visibility="Collapsed" Style="{StaticResource Small}" Text="No finding in this run carries a severity rating. Severity is only set for the findings that name a risk (for example template permissions or an open NDES admin page)."/>
                </StackPanel>
              </Border>

              <TextBlock Text="Certification authorities" Style="{StaticResource H2}" Margin="0,0,0,8"/>
              <ItemsControl x:Name="CaList" ItemTemplate="{StaticResource CaCard}" IsTabStop="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock x:Name="TxtNoCa" Visibility="Collapsed" Style="{StaticResource Muted}" Margin="0,0,0,16" Text="No Enterprise CA was found in this run."/>

              <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,16,16,8" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="Top issues" Style="{StaticResource H2}"/>
                    <TextBlock Text="The ten most serious findings. Select one to open it." Style="{StaticResource Small}" Margin="0,2,0,8"/>
                    <ItemsControl x:Name="TopList" ItemTemplate="{StaticResource TopIssue}" IsTabStop="False"/>
                    <TextBlock x:Name="TxtNoTop" Visibility="Collapsed" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="No failing or warning findings."/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="Discovery coverage" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="TxtCoverage" Style="{StaticResource Small}" Margin="0,2,0,12"/>
                    <ItemsControl x:Name="CoverageList" ItemTemplate="{StaticResource CoverageRow}" IsTabStop="False"/>
                    <Expander x:Name="ExpCoverageOk" IsExpanded="False" Margin="0,4,0,0">
                      <Expander.Header><TextBlock x:Name="TxtCoverageOk"/></Expander.Header>
                      <ItemsControl x:Name="CoverageOkList" ItemTemplate="{StaticResource CoverageRow}" IsTabStop="False" Margin="22,8,0,0"/>
                    </Expander>
                    <TextBlock x:Name="TxtLimits" Style="{StaticResource Small}" Margin="0,4,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- Findings -->
      <TabItem x:Name="TabFindings" ToolTip="Ctrl+2">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Margin="0,0,8,0"/><TextBlock Text="Findings"/>
            <TextBlock x:Name="TxtTabFindings" Style="{StaticResource Small}" Margin="8,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="400" MinWidth="300"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,12,12,4" Margin="0,0,0,8">
              <StackPanel>
                <TextBox x:Name="FltText" Tag="Search target, message, source, evidence... (Ctrl+F)" Margin="0,0,0,8" ToolTip="Type words; a finding must contain every word somewhere."/>
                <ItemsControl x:Name="ChipList" IsTabStop="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <WrapPanel Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="Severity" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="FltSeverity" Width="112"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="Category" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="FltCategory" Width="112"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="Confidence" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="FltConfidence" Width="112"/>
                  </StackPanel>
                  <CheckBox x:Name="ChkGroup" Content="Group by category" Margin="0,0,16,0" VerticalAlignment="Center"/>
                  <Button x:Name="BtnClearFilters" Margin="0,0,8,0" Padding="12,0" ToolTip="Remove every filter">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE894;" Margin="0,0,8,0"/><TextBlock Text="Clear filters"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnExport" Padding="12,0" ToolTip="Write the findings that match the filters to a CSV file in this run's output folder.">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Margin="0,0,8,0"/><TextBlock Text="Export filtered view"/></StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="TxtShowing" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="0,8,0,0"/>
            <Grid>
              <DataGrid x:Name="FindingsGrid" EnableRowVirtualization="True" CanUserSortColumns="True" AutomationProperties.Name="Findings">
                <DataGrid.ContextMenu>
                  <ContextMenu x:Name="GridMenu">
                    <MenuItem x:Name="MenuCopyRows" Header="Copy selected rows" InputGestureText="Ctrl+C"/>
                    <MenuItem x:Name="MenuCopyMessage" Header="Copy message"/>
                    <MenuItem x:Name="MenuCopyTarget" Header="Copy target"/>
                    <MenuItem x:Name="MenuCopyDetails" Header="Copy all details of this finding"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.ContainerStyle>
                      <Style TargetType="GroupItem">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                              <Expander IsExpanded="True" Background="{StaticResource B.AccentSoft}">
                                <Expander.Header>
                                  <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Foreground="{StaticResource B.Muted}"/>
                                  </StackPanel>
                                </Expander.Header>
                                <ItemsPresenter/>
                              </Expander>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </GroupStyle.ContainerStyle>
                  </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Status" SortMemberPath="StatusRank" Width="128" MinWidth="116">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" SortMemberPath="SeverityRank" Width="88" MinWidth="80"/>
                  <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="116" MinWidth="90"/>
                  <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="150" MinWidth="110">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="170">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="Confidence" SortMemberPath="ConfidenceRank" Width="128" MinWidth="116">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="TxtGridEmpty" Visibility="Collapsed" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="360"/>
            </Grid>
          </DockPanel>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"/>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ContentControl x:Name="FindingHost" Style="{StaticResource PaneHost}"/>
          </Border>
        </Grid>
      </TabItem>

      <!-- Discovery Map -->
      <TabItem x:Name="TabMap" ToolTip="Ctrl+3">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,8,0"/><TextBlock Text="Discovery Map"/></StackPanel>
        </TabItem.Header>
        <Grid Margin="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="400" MinWidth="300"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
              <DockPanel>
                <TextBlock x:Name="TxtMapCount" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                <WrapPanel>
                  <Button x:Name="BtnExpandAll" Margin="0,0,8,0" Padding="12,0" ToolTip="Open every branch of the tree">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="Expand all"/></StackPanel>
                  </Button>
                  <Button x:Name="BtnCollapseAll" Padding="12,0" ToolTip="Close every branch except the first level">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="Collapse all"/></StackPanel>
                  </Button>
                </WrapPanel>
              </DockPanel>
            </Border>
            <TreeView x:Name="MapTree" ItemTemplate="{StaticResource MapNode}" AutomationProperties.Name="Discovery map">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                  <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=OneTime}"/>
                </Style>
              </TreeView.ItemContainerStyle>
            </TreeView>
          </DockPanel>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"/>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <ContentControl x:Name="MapHost" Style="{StaticResource PaneHost}"/>
          </Border>
        </Grid>
      </TabItem>

      <!-- Run Log -->
      <TabItem x:Name="TabLog" ToolTip="Ctrl+4">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D5;" Margin="0,0,8,0"/><TextBlock Text="Run Log"/></StackPanel>
        </TabItem.Header>
        <DockPanel Margin="16">
          <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8,12,0" Margin="0,0,0,8">
            <WrapPanel>
              <TextBox x:Name="FltLog" Width="320" Tag="Filter the log (Ctrl+F)" Margin="0,0,16,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <TextBlock Text="Level" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="FltLogLevel" Width="150"/>
              </StackPanel>
              <CheckBox x:Name="ChkFollow" Content="Auto-scroll to the newest line" IsChecked="True" VerticalAlignment="Top" Margin="0,6,16,8"/>
              <Button x:Name="BtnCopyLog" Margin="0,0,16,8" Padding="12,0" ToolTip="Copy the lines that are shown to the clipboard">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,8,0"/><TextBlock Text="Copy shown lines"/></StackPanel>
              </Button>
              <TextBlock x:Name="TxtLogCount" Style="{StaticResource Small}" VerticalAlignment="Top" Margin="0,8,0,0"/>
            </WrapPanel>
          </Border>
          <Grid>
            <ListBox x:Name="LogList" ItemTemplate="{StaticResource LogRow}" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Run log"/>
            <TextBlock x:Name="TxtLogEmpty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="The log fills in while a run is in progress."/>
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- ===== Status bar ===== -->
    <Border Grid.Row="5" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="24,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,16,0">
          <TextBlock x:Name="StatusIcon" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
          <TextBlock x:Name="TxtStage" VerticalAlignment="Center" FontFamily="Segoe UI Semibold"/>
        </StackPanel>
        <TextBlock x:Name="TxtTarget" Grid.Column="1" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,0,6,0"/>
          <TextBlock x:Name="TxtElapsed" Style="{StaticResource Small}" VerticalAlignment="Center" Text="Elapsed 0:00"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,0,6,0"/>
          <TextBlock x:Name="TxtCount" Style="{StaticResource Small}" VerticalAlignment="Center" Text="0 findings"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,0,6,0"/>
          <TextBlock x:Name="TxtOutputPath" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
