<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSPKI Health Check" Width="1360" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource AppWindow}">
  <!-- Custom title bar with the in-box WindowChrome (no compiled code, no window effects). -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVis"/>

      <!-- ===== Object links (Tag "ent:<id>"): one row per related object ===== -->
      <DataTemplate x:Key="ObjectLink">
        <Button Style="{StaticResource RowButton}" Tag="{Binding Tag}" Padding="4,8" ToolTip="Open this object" AutomationProperties.Name="{Binding Name}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="4" Background="{StaticResource B.AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
              <TextBlock Text="{Binding TypeText}" Style="{StaticResource Small}"/>
            </StackPanel>
          </DockPanel>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="RelatedLink">
        <Button Style="{StaticResource RowButton}" Tag="{Binding Tag}" Padding="4,8" ToolTip="Open this object" AutomationProperties.Name="{Binding Name}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            <ContentPresenter DockPanel.Dock="Right" Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="4" Background="{StaticResource B.AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"><Run Text="{Binding Label, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TypeText, Mode=OneWay}"/></TextBlock>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            </StackPanel>
          </DockPanel>
        </Button>
      </DataTemplate>
      <!-- One place where an object was seen, named, or expected and missing. -->
      <DataTemplate x:Key="ObservationRow">
        <Border BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1" Padding="0,8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="14" Margin="2,2,12,0" VerticalAlignment="Top">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                  <Setter Property="Foreground" Value="{StaticResource B.GoodFore}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding IsMissing}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.WarnFore}"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ContentPresenter DockPanel.Dock="Right" Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top" Margin="8,0,-6,0"/>
            <StackPanel>
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding KindText, Mode=OneWay}"/><Run Text=" · " Foreground="{StaticResource B.Muted}"/><Run Text="{Binding Source, Mode=OneWay}" Foreground="{StaticResource B.Muted}"/></TextBlock>
              <TextBox Text="{Binding Location, Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="{StaticResource F.Mono}" FontSize="12" Margin="0,2,0,0"/>
              <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,2,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
              <TextBlock Text="{Binding TimeText}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="FindingLink">
        <Button Style="{StaticResource RowButton}" Tag="{Binding Id}" ToolTip="Show the full finding" Padding="4,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="8,0,0,0"/>
            <StackPanel>
              <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="FactRow">
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="0,0,12,0" TextWrapping="Wrap"/>
          <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueText}"/>
        </Grid>
      </DataTemplate>

      <!-- ===== PKI services page: one card per service kind ===== -->
      <DataTemplate x:Key="ServiceCard">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16">
          <StackPanel>
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Right" Content="{Binding StatePill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top" Margin="12,2,-6,0"/>
              <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" Background="{StaticResource B.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="18" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding StateWhy}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasStateWhy, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding About}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <StackPanel Visibility="{Binding HasInstances, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
              <TextBlock Text="{Binding InstancesTitle}" Style="{StaticResource Label}" Margin="0,0,0,2"/>
              <ItemsControl ItemsSource="{Binding Instances}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource RowButton}" Tag="{Binding Tag}" Padding="4,8" ToolTip="Open this service: where it exists, its host and certificates" AutomationProperties.Name="{Binding Name}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                          <TextBlock Style="{StaticResource Small}" Visibility="{Binding HasHost, Converter={StaticResource BoolToVis}}" TextTrimming="CharacterEllipsis"><Run Text="Host: "/><Run Text="{Binding HostName, Mode=OneWay}" FontFamily="{StaticResource F.Mono}"/></TextBlock>
                          <WrapPanel Margin="0,4,0,0">
                            <ContentPresenter Content="{Binding StatePill}" ContentTemplate="{StaticResource PillTemplate}"/>
                            <ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/>
                            <ContentPresenter Content="{Binding WorstPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                          </WrapPanel>
                          <TextBlock Text="{Binding Evidence}" Style="{StaticResource Small}" FontFamily="{StaticResource F.Mono}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
              <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2"><Run Text="Findings ("/><Run Text="{Binding FindingCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
              <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingLink}" Focusable="False"/>
              <TextBlock Text="{Binding MoreText}" Style="{StaticResource Small}" Margin="4,6,0,0"/>
            </StackPanel>
            <Border Background="{StaticResource B.Hover}" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="12" Foreground="{StaticResource B.Muted}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap"><Run Text="What this run can see: " FontWeight="SemiBold"/><Run Text="{Binding Scope, Mode=OneWay}"/></TextBlock>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </DataTemplate>

      <!-- ===== Details pane: one object of the graph (G1 drill-down, G2 where it exists, G4 host identity, G5 note) ===== -->
      <DataTemplate x:Key="EntityPane">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="20,16,16,14" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
              <Button Tag="Back" Style="{StaticResource LinkButton}" Margin="0,0,0,8" HorizontalAlignment="Left" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" ToolTip="{Binding BackText}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="{Binding BackText}" MaxWidth="420" TextTrimming="CharacterEllipsis"/></StackPanel>
              </Button>
              <ItemsControl ItemsSource="{Binding Breadcrumbs}" Focusable="False" Margin="0,0,0,10" Visibility="{Binding ShowCrumbs, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Path">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource B.Muted}" Margin="6,0,6,0" Visibility="{Binding NotFirst, Converter={StaticResource BoolToVis}}"/>
                      <Button Tag="{Binding Tag}" Style="{StaticResource LinkButton}" Visibility="{Binding NotLast, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Name}">
                        <TextBlock Text="{Binding Name}" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="12"/>
                      </Button>
                      <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource B.Muted}" VerticalAlignment="Center" Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Name}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <DockPanel>
                <Button DockPanel.Dock="Right" Tag="Copy" Style="{StaticResource SubtleButton}" ToolTip="Copy this object, where it exists and its related objects to the clipboard" AutomationProperties.Name="Copy" VerticalAlignment="Top" Margin="8,-4,-4,0" Width="32" Padding="0"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE8C8;" Margin="0" HorizontalAlignment="Center"/></Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="28" Height="28" CornerRadius="4" Background="{StaticResource B.AccentSoft}" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding TypeGlyph}" FontSize="14" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{Binding TypeText}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
              <TextBox Text="{Binding Id, Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,2,0,0"/>
              <WrapPanel Margin="0,8,0,0">
                <Border Style="{StaticResource PillBorder}" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}" Background="{StaticResource B.WarnBack}" BorderBrush="{StaticResource B.WarnLine}" TextElement.Foreground="{StaticResource B.WarnFore}">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="{Binding MissingBadge}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
                </Border>
                <Border Style="{StaticResource PillBorder}">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="{Binding SeenBadge}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
                </Border>
                <Border Style="{StaticResource PillBorder}">
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="12" Margin="0,0,5,0"/><TextBlock Text="{Binding FindingBadge}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16,20,20">
              <Border Visibility="{Binding HasAbout, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16" Background="{StaticResource B.InfoBack}" BorderBrush="{StaticResource B.InfoLine}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{StaticResource B.InfoFore}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                  <StackPanel>
                    <TextBlock Text="What this is and why it matters" FontWeight="SemiBold" Foreground="{StaticResource B.InfoFore}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding About, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <StackPanel Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                <Border Background="{StaticResource B.WarnBack}" BorderBrush="{StaticResource B.WarnLine}" BorderThickness="1" CornerRadius="6" Padding="12,10,12,4">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                      <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{StaticResource B.WarnFore}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource B.WarnFore}"><Run Text="Expected here, but missing ("/><Run Text="{Binding MissingCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                        <TextBlock Text="These places were checked in this run and the object was not there." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource ObservationRow}" Focusable="False"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Visibility="{Binding HasHostFacts, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                <TextBlock Text="Host identity" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding HostFacts}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Visibility="{Binding HasProperties, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                <TextBlock Text="Properties" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactRow}" Focusable="False"/>
              </StackPanel>

              <TextBlock Style="{StaticResource Label}" Margin="0,0,0,2"><Run Text="Where this exists ("/><Run Text="{Binding SeenCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
              <TextBlock Text="Every place this run read the object itself, or found something that names it." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,2"/>
              <ItemsControl ItemsSource="{Binding Seen}" ItemTemplate="{StaticResource ObservationRow}" Focusable="False"/>
              <TextBlock Text="This run did not record where the object was seen." Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding NoSeen, Converter={StaticResource BoolToVis}}"/>

              <TextBlock Style="{StaticResource Label}" Margin="0,20,0,4"><Run Text="Related objects ("/><Run Text="{Binding RelatedCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
              <ItemsControl ItemsSource="{Binding Related}" ItemTemplate="{StaticResource RelatedLink}" Focusable="False"/>
              <TextBlock Text="No other object is linked to this one." Style="{StaticResource Muted}" Visibility="{Binding NoRelated, Converter={StaticResource BoolToVis}}"/>

              <TextBlock Style="{StaticResource Label}" Margin="0,20,0,4"><Run Text="Findings for this object ("/><Run Text="{Binding FindingCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
              <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingLink}" Focusable="False"/>
              <TextBlock Text="No finding is about this object." Style="{StaticResource Muted}" Visibility="{Binding NoFindings, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </DataTemplate>

      <!-- ===== Details pane: one finding ===== -->
      <DataTemplate x:Key="FindingPane">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="20,16,16,14" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
              <Button Tag="Back" Style="{StaticResource LinkButton}" Margin="0,0,0,10" HorizontalAlignment="Left" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" ToolTip="{Binding BackText}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="{Binding BackText}" MaxWidth="420" TextTrimming="CharacterEllipsis"/></StackPanel>
              </Button>
              <DockPanel>
                <Button DockPanel.Dock="Right" Tag="Copy" Style="{StaticResource SubtleButton}" ToolTip="Copy every field of this finding to the clipboard" AutomationProperties.Name="Copy" VerticalAlignment="Top" Margin="8,-4,-4,0" Width="32" Padding="0"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE8C8;" Margin="0" HorizontalAlignment="Center"/></Button>
                <WrapPanel VerticalAlignment="Top">
                  <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                  <ContentPresenter Content="{Binding SeverityPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                  <ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/>
                </WrapPanel>
              </DockPanel>
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
              <TextBlock Text="{Binding Id}" Style="{StaticResource Small}" FontFamily="{StaticResource F.Mono}" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16,20,20">
              <TextBlock Text="What was found" Style="{StaticResource Label}" Margin="0,0,0,6"/>
              <TextBox Text="{Binding Message, Mode=OneWay}" Style="{StaticResource ValueText}" FontSize="14"/>

              <Border Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0" Background="{StaticResource B.InfoBack}" BorderBrush="{StaticResource B.InfoLine}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE82F;" Foreground="{StaticResource B.InfoFore}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                  <StackPanel>
                    <TextBlock Text="Suggested action" FontWeight="SemiBold" Foreground="{StaticResource B.InfoFore}" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Remediation, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <StackPanel Visibility="{Binding HasObjects, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4"><Run Text="Objects this finding is about ("/><Run Text="{Binding ObjectCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                <ItemsControl ItemsSource="{Binding Objects}" ItemTemplate="{StaticResource ObjectLink}" Focusable="False"/>
              </StackPanel>

              <TextBlock Text="Checked layers" Style="{StaticResource Label}" Margin="0,20,0,6"/>
              <ItemsControl ItemsSource="{Binding Layers}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate><ContentPresenter Content="{Binding Pill}" ContentTemplate="{StaticResource PillTemplate}"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Details" Style="{StaticResource Label}" Margin="0,20,0,6"/>
              <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="0,0,12,0"/>
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueText}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Sources" Style="{StaticResource Label}" Margin="0,14,0,6"/>
              <Border Background="{StaticResource B.Hover}" CornerRadius="4" Padding="10,8">
                <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="{StaticResource F.Mono}" FontSize="12" Margin="0,1"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <StackPanel Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                <TextBlock Text="Evidence" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Evidence, Mode=OneWay}" Style="{StaticResource ReadBox}" MaxHeight="320"/>
              </StackPanel>

              <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Notes, Mode=OneWay}" Style="{StaticResource ValueText}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </DataTemplate>

      <!-- ===== Details pane: one Discovery map item ===== -->
      <DataTemplate x:Key="NodePane">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="20,16,16,14" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Tag="Copy" Style="{StaticResource SubtleButton}" ToolTip="Copy this item to the clipboard" AutomationProperties.Name="Copy" VerticalAlignment="Top" Margin="8,-4,-4,0" Width="32" Padding="0"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE8C8;" Margin="0" HorizontalAlignment="Center"/></Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="28" Height="28" CornerRadius="4" Background="{StaticResource B.AccentSoft}" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding TypeGlyph}" FontSize="14" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="{Binding TypeText}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,6"/>
              <WrapPanel>
                <ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                <ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/>
              </WrapPanel>
              <TextBlock Text="{Binding BelowText}" Visibility="{Binding HasBelow, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource B.BadFore}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16,20,20">
              <TextBlock Text="Details" Style="{StaticResource Label}" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource ValueText}" Margin="0,0,0,6"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding NoDetailText}" Style="{StaticResource Muted}"/>

              <TextBlock Text="Sources" Style="{StaticResource Label}" Margin="0,14,0,6"/>
              <Border Background="{StaticResource B.Hover}" CornerRadius="4" Padding="10,8">
                <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource ValueText}" FontFamily="{StaticResource F.Mono}" FontSize="12" Margin="0,1"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <StackPanel Visibility="{Binding HasObjects, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4"><Run Text="Objects of this item ("/><Run Text="{Binding ObjectCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                <ItemsControl ItemsSource="{Binding Objects}" ItemTemplate="{StaticResource ObjectLink}" Focusable="False"/>
              </StackPanel>

              <TextBlock Margin="0,20,0,4" Style="{StaticResource Label}"><Run Text="Findings for this item ("/><Run Text="{Binding FindingCount, Mode=OneWay}"/><Run Text=")"/></TextBlock>
              <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingLink}" Focusable="False"/>
              <TextBlock Text="No finding is attached to this item." Style="{StaticResource Muted}" Visibility="{Binding NoFindings, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </DataTemplate>

      <DataTemplate x:Key="EmptyPane">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32" MaxWidth="300">
          <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource B.Hover}" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="24" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="Nothing selected" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" TextAlignment="Center"/>
        </StackPanel>
      </DataTemplate>

      <!-- The pane host switches its template on the Kind of what it shows. -->
      <Style x:Key="PaneHost" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ContentTemplate" Value="{StaticResource EmptyPane}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Finding"><Setter Property="ContentTemplate" Value="{StaticResource FindingPane}"/></DataTrigger>
          <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Node"><Setter Property="ContentTemplate" Value="{StaticResource NodePane}"/></DataTrigger>
          <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Entity"><Setter Property="ContentTemplate" Value="{StaticResource EntityPane}"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ===== Overview templates ===== -->
      <DataTemplate x:Key="KpiTile">
        <Button Style="{StaticResource CardButton}" Tag="{Binding Tag}" Margin="0,0,16,0" ToolTip="List these objects on the Objects page" AutomationProperties.Name="{Binding Label}">
          <Grid Margin="20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
              <Border DockPanel.Dock="Right" Width="32" Height="32" CornerRadius="6" Background="{StaticResource B.AccentSoft}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Grid.Row="2" Text="{Binding Sub}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </Grid>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="CountTile">
        <Button Style="{StaticResource TileButton}" Tag="{Binding Tag}" Margin="0,0,12,12" Height="64"
                ToolTip="Show these findings on the Findings page" AutomationProperties.Name="{Binding Label}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource ToneStripe}"/>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource ToneGlyph}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="CaCard">
        <Button Style="{StaticResource CardButton}" Tag="{Binding Tag}" Margin="0,0,16,16" ToolTip="Open this CA: where it exists, its certificates, hosts and findings" AutomationProperties.Name="{Binding Name}">
          <StackPanel Margin="20,16">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Right" Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Top" Margin="12,0,-6,0"/>
              <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" Background="{StaticResource B.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="18" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                <TextBlock Text="{Binding Host}" Style="{StaticResource Small}" FontFamily="{StaticResource F.Mono}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Host}"/>
              </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Divider}" Margin="0,14,0,12"/>
            <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,8,0,4">
              <ContentPresenter Content="{Binding ExpiryPill}" ContentTemplate="{StaticResource PillTemplate}"/>
              <ContentPresenter Content="{Binding CrlPill}" ContentTemplate="{StaticResource PillTemplate}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Certificate}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Facts}" Style="{StaticResource Small}" Margin="0,4,0,0"/>
          </StackPanel>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="TopIssue">
        <Button Style="{StaticResource RowButton}" Tag="{Binding Id}" ToolTip="Open this finding on the Findings page">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <DockPanel>
                <ContentPresenter DockPanel.Dock="Left" Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="{Binding Title}"/>
              </DockPanel>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
              <TextBlock Text="{Binding Meta}" Style="{StaticResource Small}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </DataTemplate>

      <DataTemplate x:Key="CoverageRow">
        <StackPanel Margin="0,0,0,12">
          <DockPanel>
            <ContentPresenter DockPanel.Dock="Left" Content="{Binding Pill}" ContentTemplate="{StaticResource PillTemplate}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Method}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="{Binding Method}"/>
          </DockPanel>
          <TextBlock Text="{Binding Reason}" Style="{StaticResource Small}" Margin="0,4,0,0"/>
        </StackPanel>
      </DataTemplate>

      <!-- Environment facts in the navigation pane. -->
      <DataTemplate x:Key="HeaderFact">
        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource B.Muted}"/>
          <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
        </StackPanel>
      </DataTemplate>

      <!-- The user badge in the title bar (icon + word; purple tint for Administrator). -->
      <DataTemplate x:Key="HeaderBadge">
        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" BorderBrush="#4A5160" Padding="8,0" Height="24" ToolTip="Rights of the account this window runs as">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="G" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource B.HeaderSub}" Margin="0,0,6,0"/>
            <TextBlock x:Name="T" Text="{Binding Text}" FontSize="12" Foreground="#E6E9EE" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Tone}" Value="Admin">
            <Setter TargetName="Bd" Property="BorderBrush" Value="#8F6CC9"/><Setter TargetName="Bd" Property="Background" Value="#3A2D57"/><Setter TargetName="G" Property="Foreground" Value="#D9C8F5"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Run log row: the level is in the text; colour and weight only add to it. -->
      <DataTemplate x:Key="LogRow">
        <TextBlock FontFamily="{StaticResource F.Mono}" FontSize="12" TextWrapping="NoWrap" Margin="0,1">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{StaticResource B.BadFore}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource B.WarnFore}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Debug"><Setter Property="Foreground" Value="{StaticResource B.Muted}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Run Text="{Binding Text, Mode=OneWay}"/>
        </TextBlock>
      </DataTemplate>

      <HierarchicalDataTemplate x:Key="MapNode" ItemsSource="{Binding Children}">
        <!-- Status as its own icon (each status has a different shape, the word is in the tooltip and the details pane). -->
        <StackPanel Orientation="Horizontal" MinHeight="28">
          <TextBlock Style="{StaticResource Glyph}" Text="{Binding TypeGlyph}" FontSize="14" Foreground="{StaticResource B.Accent}" Margin="0,0,10,0" ToolTip="{Binding TypeText}"/>
          <TextBlock DataContext="{Binding StatusPill}" Style="{StaticResource ToneGlyph}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,8,0" ToolTip="{Binding Text}"/>
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip="{Binding Label}" Margin="0,0,10,0"/>
          <TextBlock Text="{Binding ConfidencePill.Text}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Confidence"/>
          <Border CornerRadius="4" Background="{StaticResource B.BadBack}" BorderBrush="{StaticResource B.BadLine}" BorderThickness="1" Padding="6,0" Height="20" VerticalAlignment="Center" Visibility="{Binding HasBelow, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BelowText}" Foreground="{StaticResource B.BadFore}" FontSize="12" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </HierarchicalDataTemplate>

      <!-- Navigation label: hidden in compact navigation (NavList.Tag = Compact, set by the window code on narrow widths). -->
      <Style x:Key="NavLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, ElementName=NavList}" Value="Compact"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Page subtitle: hidden in compact navigation, where vertical room is short. -->
      <Style x:Key="PageSub" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Tag, ElementName=NavList}" Value="Compact"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Maximised: WindowChrome lets the window overhang the screen by its frame, so pad the content back in. -->
      <Style x:Key="RootFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="#C7C7C7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="MaxButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Content" Value="&#xE922;"/>
        <Setter Property="ToolTip" Value="Maximise"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="Content" Value="&#xE923;"/><Setter Property="ToolTip" Value="Restore"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border x:Name="RootBorder" Style="{StaticResource RootFrame}" Background="{StaticResource B.Window}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="232"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Title bar ===== -->
      <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource B.Header}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Border Width="24" Height="24" CornerRadius="4" Background="{StaticResource B.Accent}" Margin="0,0,12,0">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="14" Foreground="{StaticResource B.White}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="MSPKI Health Check" FontWeight="SemiBold" Foreground="{StaticResource B.White}" VerticalAlignment="Center"/>
            <TextBlock x:Name="HdrVersion" FontSize="12" Foreground="{StaticResource B.HeaderSub}" VerticalAlignment="Center" Margin="8,1,0,0"/>
            <Border CornerRadius="4" BorderThickness="1" BorderBrush="#4A5160" Padding="6,0,8,0" Height="22" Margin="16,0,0,0" ToolTip="This tool only reads. It never changes Active Directory, a CA or any server.">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="11" Foreground="{StaticResource B.HeaderSub}" Margin="0,0,6,0"/>
                <TextBlock Text="Read-only" FontSize="12" Foreground="#E6E9EE" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <ContentPresenter x:Name="HdrBadge" Grid.Column="2" ContentTemplate="{StaticResource HeaderBadge}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimise" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimise"/>
            <Button x:Name="BtnMax" Style="{StaticResource MaxButton}" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximise or restore"/>
            <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Navigation pane ===== -->
      <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource B.Nav}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- Compact navigation (narrow window): the environment collapses to one icon with the facts in its tooltip. -->
          <Border x:Name="NavEnvCompact" DockPanel.Dock="Bottom" Visibility="Collapsed" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Height="48" Background="Transparent">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
          </Border>
          <Border x:Name="NavEnv" DockPanel.Dock="Bottom" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="20,14,16,6">
            <StackPanel>
              <TextBlock Text="Environment" Style="{StaticResource Label}" Margin="0,0,0,8"/>
              <ItemsControl x:Name="HdrContext" ItemTemplate="{StaticResource HeaderFact}" IsTabStop="False" Focusable="False"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="0,12,0,0">
            <ListBox x:Name="NavList" Style="{StaticResource NavList}" SelectedIndex="{Binding SelectedIndex, ElementName=Tabs, Mode=TwoWay}" AutomationProperties.Name="Pages">
              <ListBoxItem ToolTip="Overview (Ctrl+1)" AutomationProperties.Name="Overview">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,12,0"/><TextBlock Text="Overview" Style="{StaticResource NavLabel}"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem ToolTip="Findings (Ctrl+2)" AutomationProperties.Name="Findings">
                <DockPanel>
                  <Border DockPanel.Dock="Right" CornerRadius="9" Background="#E0E0E0" Padding="7,0" Height="18" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TxtTabFindings}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Tag, ElementName=NavList}" Value="Compact"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock x:Name="TxtTabFindings" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" Margin="0,0,12,0"/><TextBlock Text="Findings" Style="{StaticResource NavLabel}"/></StackPanel>
                </DockPanel>
              </ListBoxItem>
              <ListBoxItem ToolTip="Discovery map (Ctrl+3)" AutomationProperties.Name="Discovery map">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE81E;" Margin="0,0,12,0"/><TextBlock Text="Discovery map" Style="{StaticResource NavLabel}"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem ToolTip="Run log (Ctrl+4)" AutomationProperties.Name="Run log">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D5;" Margin="0,0,12,0"/><TextBlock Text="Run log" Style="{StaticResource NavLabel}"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem ToolTip="Objects (Ctrl+5)" AutomationProperties.Name="Objects">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" Margin="0,0,12,0"/><TextBlock Text="Objects" Style="{StaticResource NavLabel}"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem ToolTip="PKI services (Ctrl+6)" AutomationProperties.Name="PKI services">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE912;" Margin="0,0,12,0"/><TextBlock Text="PKI services" Style="{StaticResource NavLabel}"/></StackPanel>
              </ListBoxItem>
            </ListBox>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===== Content column ===== -->
      <DockPanel Grid.Row="1" Grid.Column="1">
        <!-- Command bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Height="48" Padding="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnRun" Style="{StaticResource SubtleButton}" ToolTip="Start a new health check (F5). It only reads; nothing is changed.">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE768;"/><TextBlock Text="Run health check"/></StackPanel>
            </Button>
            <Button x:Name="BtnCancel" Style="{StaticResource SubtleButton}" IsEnabled="False" Margin="4,0,0,0" ToolTip="Stop the run at the next step (Esc). Partial results are still saved.">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE711;"/><TextBlock Text="Cancel"/></StackPanel>
            </Button>
            <Border Style="{StaticResource VDivider}"/>
            <Button x:Name="BtnOpenResults" Style="{StaticResource SubtleButton}" ToolTip="Look at an earlier run without scanning anything (Ctrl+O).">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE8E5;"/><TextBlock Text="Open results"/></StackPanel>
            </Button>
            <Button x:Name="BtnOpenReport" Style="{StaticResource SubtleButton}" Margin="4,0,0,0" IsEnabled="False" ToolTip="Open the HTML report of this run in the browser.">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE774;"/><TextBlock Text="Open report"/></StackPanel>
            </Button>
            <Button x:Name="BtnOpenFolder" Style="{StaticResource SubtleButton}" Margin="4,0,0,0" ToolTip="Open the folder that holds the results of this run.">
              <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE838;"/><TextBlock Text="Open folder"/></StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Run options -->
        <Border DockPanel.Dock="Top" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="16,4">
          <Expander x:Name="ExpOptions" IsExpanded="False">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="14" Foreground="{StaticResource B.Muted}" Margin="0,0,8,0"/>
                <TextBlock Text="Run options" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtOptionsSummary" FontWeight="Normal" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="16,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Expander.Header>
            <Grid Margin="28,8,0,12" MaxWidth="900" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Timeout per probe" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,7,0,12"/>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="TxtTimeout" Width="72" Text="5" ToolTip="Whole number from 1 to 120." AutomationProperties.Name="Timeout per probe in seconds"/>
                <TextBlock Text="seconds (1 to 120). Every network call stops after this time." Style="{StaticResource Small}" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Network" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,5,0,12"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                <CheckBox x:Name="ChkSkipNetwork" Style="{StaticResource Switch}" Content="Skip network (read Active Directory only)" ToolTip="Do not contact any CA or web server. Only Active Directory is read."/>
                <TextBlock Text="No CA, web server or other host is contacted." Style="{StaticResource Small}" Margin="52,0,0,0"/>
              </StackPanel>
              <TextBlock Grid.Row="2" Text="Proxy" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,5,0,12"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                <CheckBox x:Name="ChkProxy" Style="{StaticResource Switch}" Content="Use the system proxy for web probes" ToolTip="Off by default: web probes connect directly, without credentials."/>
                <TextBlock Text="Off by default: web probes connect directly and never send credentials." Style="{StaticResource Small}" Margin="52,0,0,0"/>
              </StackPanel>
              <TextBlock Grid.Row="3" Text="NDES" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,5,0,12"/>
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
                <CheckBox x:Name="ChkNdesAdmin" Style="{StaticResource Switch}" Content="Also probe the NDES admin page (opt-in)" ToolTip="Sends one anonymous request to the NDES admin page."/>
                <TextBlock Text="One anonymous request. If that page is wrongly open it creates a challenge password on the server, so this is off by default." Style="{StaticResource Small}" Margin="52,0,0,0"/>
              </StackPanel>
              <TextBlock Grid.Row="4" Text="Output folder" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,7,0,0"/>
              <TextBox x:Name="TxtOutput" Grid.Row="4" Grid.Column="1" IsReadOnly="True" AutomationProperties.Name="Output folder"/>
            </Grid>
          </Expander>
        </Border>

        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Minimum="0" Maximum="100" Value="0" Visibility="Hidden" AutomationProperties.Name="Run progress"/>

        <!-- ===== Pages ===== -->
        <TabControl x:Name="Tabs">
          <!-- Overview -->
          <TabItem x:Name="TabSummary" Header="Overview">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <Grid>
                <!-- Welcome state: before the first run, and after a run that ended without results -->
                <StackPanel x:Name="PanelWelcome" Margin="24,32,24,24" MaxWidth="880" HorizontalAlignment="Center">
                  <Border Style="{StaticResource Card}" Padding="32,28">
                    <StackPanel>
                      <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource B.AccentSoft}" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="24" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="Check the health of your certificate services" FontSize="24" FontWeight="SemiBold"/>
                      <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,24" Text="A read-only check of Microsoft Active Directory Certificate Services. It finds your CAs, templates and endpoints by itself: there is nothing to configure."/>
                      <UniformGrid Columns="3" Margin="0,0,-16,0">
                        <Border Background="{StaticResource B.Hover}" CornerRadius="6" Padding="16,14" Margin="0,0,16,0">
                          <StackPanel>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource B.Accent}" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="1" Foreground="{StaticResource B.White}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Discover" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Text="Reads the Public Key Services in Active Directory, then asks each CA about itself."/>
                          </StackPanel>
                        </Border>
                        <Border Background="{StaticResource B.Hover}" CornerRadius="6" Padding="16,14" Margin="0,0,16,0">
                          <StackPanel>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource B.Accent}" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="2" Foreground="{StaticResource B.White}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Check" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Text="Tests only the CRL, AIA, OCSP and enrollment addresses the CAs and certificates name. Anonymous requests, no scanning."/>
                          </StackPanel>
                        </Border>
                        <Border Background="{StaticResource B.Hover}" CornerRadius="6" Padding="16,14" Margin="0,0,16,0">
                          <StackPanel>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource B.Accent}" HorizontalAlignment="Left" Margin="0,0,0,10"><TextBlock Text="3" Foreground="{StaticResource B.White}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Report" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Text="Every finding shows its sources, its evidence and how sure the tool is. Files go to the output folder only."/>
                          </StackPanel>
                        </Border>
                      </UniformGrid>
                      <Border x:Name="WelcomeError" Visibility="Collapsed" Background="{StaticResource B.BadBack}" BorderBrush="{StaticResource B.BadLine}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,20,0,0">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xEA39;" Foreground="{StaticResource B.BadFore}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                          <StackPanel>
                            <TextBlock Text="The last run ended without results" FontWeight="SemiBold" Foreground="{StaticResource B.BadFore}"/>
                            <TextBlock x:Name="TxtWelcomeError" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          </StackPanel>
                        </DockPanel>
                      </Border>
                      <Border Background="{StaticResource B.InfoBack}" BorderBrush="{StaticResource B.InfoLine}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,20,0,0">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{StaticResource B.InfoFore}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                          <TextBlock x:Name="TxtWelcomeContext" TextWrapping="Wrap"/>
                        </DockPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="BtnWelcomeRun" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="16,0">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Run health check"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnWelcomeOpen" Padding="16,0">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Open an earlier results.json"/></StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Running: everything here is bound to the status bar and progress bar, so it updates with them. -->
                <StackPanel x:Name="PanelRunning" Margin="24,32,24,24" MaxWidth="880" HorizontalAlignment="Center" Visibility="Collapsed">
                  <Border Style="{StaticResource Card}" Padding="32,28">
                    <StackPanel>
                      <DockPanel>
                        <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="8" Background="{StaticResource B.AccentSoft}" Margin="0,0,16,0">
                          <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="22" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="Health check in progress" FontSize="20" FontWeight="SemiBold"/>
                          <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Nothing is changed. Results appear here when the run finishes; partial results are kept if you cancel."/>
                        </StackPanel>
                      </DockPanel>
                      <DockPanel Margin="0,24,0,8">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Bottom">
                          <Run Text="{Binding Value, ElementName=Progress, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text=" %"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Text, ElementName=TxtStage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Value, ElementName=Progress, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Run progress"/>
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Now checking" Style="{StaticResource Small}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=TxtTarget}" Style="{StaticResource Small}" FontFamily="{StaticResource F.Mono}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=TxtTarget}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Text, ElementName=TxtElapsed}" Style="{StaticResource Small}" Margin="16,0,0,0"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="BtnRunningLog" Padding="16,0" Margin="0,0,8,0" ToolTip="Follow the run step by step (Ctrl+4)">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D5;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="View live log"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnRunningCancel" Padding="16,0" IsEnabled="{Binding IsEnabled, ElementName=BtnCancel}" ToolTip="Stop the run at the next step (Esc). Partial results are still saved.">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Cancel run"/></StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Results -->
                <StackPanel x:Name="PanelResults" Margin="24,20,24,24" Visibility="Collapsed">
                  <DockPanel Margin="0,0,0,16">
                    <TextBlock Text="Overview" Style="{StaticResource PageTitle}" DockPanel.Dock="Top"/>
                    <TextBlock Text="Health of Active Directory Certificate Services as seen by this run." Style="{StaticResource PageSub}" Margin="0,2,0,0"/>
                  </DockPanel>
                  <Border x:Name="Banner" Style="{StaticResource ToneBlock}" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="BannerGlyph" Style="{StaticResource ToneGlyph}" FontSize="24" Margin="4,0,16,0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="BannerTitle" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <Border Grid.Column="2" BorderBrush="#26000000" BorderThickness="1,0,0,0" Margin="24,0,0,0" Padding="16,0,4,0" VerticalAlignment="Center">
                        <StackPanel MinWidth="190">
                          <TextBlock x:Name="BannerMeta1" FontSize="12"/>
                          <TextBlock x:Name="BannerMeta2" FontSize="12" Margin="0,2,0,0"/>
                          <TextBlock x:Name="BannerMeta3" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                  <Border Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="{Binding Visibility, ElementName=TxtNote}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{StaticResource B.InfoFore}" VerticalAlignment="Top" Margin="4,1,10,0"/>
                      <TextBlock x:Name="TxtNote" Visibility="Collapsed" TextWrapping="Wrap"/>
                    </DockPanel>
                  </Border>

                  <ItemsControl x:Name="KpiList" ItemTemplate="{StaticResource KpiTile}" Margin="0,0,-16,16" IsTabStop="False" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>

                  <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16,8,4">
                    <StackPanel>
                      <DockPanel Margin="0,0,12,12">
                        <TextBlock DockPanel.Dock="Right" Text="Select a tile to filter the Findings page." Style="{StaticResource Small}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotal" Style="{StaticResource H2}" Text="Findings"/>
                      </DockPanel>
                      <TextBlock Text="By status" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                      <ItemsControl x:Name="TileList" ItemTemplate="{StaticResource CountTile}" IsTabStop="False" Focusable="False" Tag="4">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock Text="By severity" Style="{StaticResource Label}" Margin="0,4,0,8"/>
                      <ItemsControl x:Name="SevTileList" ItemTemplate="{StaticResource CountTile}" IsTabStop="False" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock x:Name="TxtNoSeverity" Visibility="Collapsed" Style="{StaticResource Small}" Margin="0,0,12,12" Text="No finding in this run carries a severity rating. Severity is only set for findings that name a risk (for example template permissions or an open NDES admin page)."/>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="Certification authorities" Style="{StaticResource H2}" Margin="0,4,0,10"/>
                  <ItemsControl x:Name="CaList" ItemTemplate="{StaticResource CaCard}" IsTabStop="False" Focusable="False" Margin="0,0,-16,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Visibility, ElementName=TxtNoCa}">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="{StaticResource B.Hover}" Margin="0,0,14,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" FontSize="16" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNoCa" Visibility="Collapsed" FontWeight="SemiBold" Text="No Enterprise CA was found in this run."/>
                        <TextBlock Style="{StaticResource Small}" Margin="0,2,0,0" Text="Check Discovery coverage below: the Enrollment Services container may be empty, unreadable, or this computer may not see the forest's Configuration partition."/>
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20,16,20,8" VerticalAlignment="Top">
                      <StackPanel>
                        <TextBlock Text="Top issues" Style="{StaticResource H2}"/>
                        <TextBlock Text="The ten most serious findings. Select one to open it." Style="{StaticResource Small}" Margin="0,2,0,8"/>
                        <Border Style="{StaticResource Divider}"/>
                        <ItemsControl x:Name="TopList" ItemTemplate="{StaticResource TopIssue}" IsTabStop="False" Focusable="False" Margin="-8,0"/>
                        <StackPanel Visibility="{Binding Visibility, ElementName=TxtNoTop}" Orientation="Horizontal" Margin="0,12,0,8">
                          <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="14" Foreground="{StaticResource B.GoodFore}" Margin="0,0,8,0"/>
                          <TextBlock x:Name="TxtNoTop" Visibility="Collapsed" Text="No failing or warning findings."/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                      <StackPanel>
                        <TextBlock Text="Discovery coverage" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="TxtCoverage" Style="{StaticResource Small}" Margin="0,2,0,8"/>
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="CoverageList" ItemTemplate="{StaticResource CoverageRow}" IsTabStop="False" Focusable="False"/>
                        <Expander x:Name="ExpCoverageOk" IsExpanded="False" Margin="-4,0,0,0">
                          <Expander.Header><TextBlock x:Name="TxtCoverageOk"/></Expander.Header>
                          <ItemsControl x:Name="CoverageOkList" ItemTemplate="{StaticResource CoverageRow}" IsTabStop="False" Focusable="False" Margin="4,8,0,0"/>
                        </Expander>
                        <TextBlock x:Name="TxtLimits" Style="{StaticResource Small}" Margin="0,8,0,0" Visibility="Collapsed"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <!-- Findings -->
          <TabItem x:Name="TabFindings" Header="Findings">
            <DockPanel Margin="24,20,24,24">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Findings" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Every check result with its sources and evidence. Select a row to see the details." Style="{StaticResource PageSub}" Margin="0,2,0,0"/>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5*" MinWidth="420"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="640"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" ClipToBounds="True">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14,16,10" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                          <Button x:Name="BtnClearFilters" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" ToolTip="Remove every filter">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE894;" FontSize="14"/><TextBlock Text="Clear filters"/></StackPanel>
                          </Button>
                          <CheckBox x:Name="ChkGroup" DockPanel.Dock="Right" Content="Group by category" Margin="16,0,0,0" VerticalAlignment="Center"/>
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="640"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FltText" Style="{StaticResource SearchBox}" Tag="Search target, message, source or evidence (Ctrl+F)" ToolTip="Type words; a finding must contain every word somewhere." AutomationProperties.Name="Search findings"/>
                          </Grid>
                        </DockPanel>
                        <ItemsControl x:Name="ChipList" IsTabStop="False" Focusable="False">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,0,8"/></Style></ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                        <WrapPanel>
                          <ComboBox x:Name="FltSeverity" Style="{StaticResource FilterCombo}" Tag="Severity" Width="160" Margin="0,0,8,8" AutomationProperties.Name="Severity filter"/>
                          <ComboBox x:Name="FltCategory" Style="{StaticResource FilterCombo}" Tag="Category" Width="176" Margin="0,0,8,8" AutomationProperties.Name="Category filter"/>
                          <ComboBox x:Name="FltConfidence" Style="{StaticResource FilterCombo}" Tag="Confidence" Width="184" Margin="0,0,8,8" AutomationProperties.Name="Confidence filter"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,1,0,0" Padding="16,0,8,0" Height="44">
                      <DockPanel>
                        <Button x:Name="BtnExport" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" VerticalAlignment="Center" ToolTip="Write the findings that match the filters to a CSV file in this run's output folder.">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE896;" FontSize="14"/><TextBlock Text="Export filtered view"/></StackPanel>
                        </Button>
                        <TextBlock x:Name="TxtShowing" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                    <Grid>
                      <DataGrid x:Name="FindingsGrid" EnableRowVirtualization="True" CanUserSortColumns="True" AutomationProperties.Name="Findings">
                        <DataGrid.ContextMenu>
                          <ContextMenu x:Name="GridMenu">
                            <MenuItem x:Name="MenuCopyRows" Header="Copy selected rows" InputGestureText="Ctrl+C" Icon="&#xE8C8;"/>
                            <MenuItem x:Name="MenuCopyMessage" Header="Copy message" Icon="&#xE8A5;"/>
                            <MenuItem x:Name="MenuCopyTarget" Header="Copy target" Icon="&#xE71B;"/>
                            <MenuItem x:Name="MenuCopyDetails" Header="Copy all details of this finding" Icon="&#xE8FD;"/>
                          </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.GroupStyle>
                          <GroupStyle>
                            <GroupStyle.ContainerStyle>
                              <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                  <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                      <Expander IsExpanded="True">
                                        <Expander.Header>
                                          <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <Border CornerRadius="9" Background="#E0E0E0" Padding="7,0" Height="18" Margin="8,0,0,0" VerticalAlignment="Center">
                                              <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Border>
                                          </StackPanel>
                                        </Expander.Header>
                                        <ItemsPresenter/>
                                      </Expander>
                                    </ControlTemplate>
                                  </Setter.Value>
                                </Setter>
                              </Style>
                            </GroupStyle.ContainerStyle>
                          </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                          <DataGridTemplateColumn Header="Status" SortMemberPath="StatusRank" Width="144" MinWidth="144">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate><ContentPresenter Content="{Binding StatusPill}" ContentTemplate="{StaticResource PillTemplate}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <!-- Most useful first: status, target and message stay in view at the minimum size; the rest scroll. -->
                          <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="150" MinWidth="120">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Target}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="200">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="128" MinWidth="96">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                          </DataGridTextColumn>
                          <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" SortMemberPath="SeverityRank" Width="88" MinWidth="80"/>
                          <DataGridTemplateColumn Header="Confidence" SortMemberPath="ConfidenceRank" Width="136" MinWidth="128">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate><ContentPresenter Content="{Binding ConfidencePill}" ContentTemplate="{StaticResource PillTemplate}"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                        </DataGrid.Columns>
                      </DataGrid>
                      <StackPanel Visibility="{Binding Visibility, ElementName=TxtGridEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource B.Hover}" HorizontalAlignment="Center" Margin="0,0,0,14">
                          <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="24" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtGridEmpty" Visibility="Collapsed" Style="{StaticResource Muted}" TextAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"/>
                <Border Grid.Column="2" Style="{StaticResource Panel}" ClipToBounds="True">
                  <ContentControl x:Name="FindingHost" Style="{StaticResource PaneHost}"/>
                </Border>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- Discovery map -->
          <TabItem x:Name="TabMap" Header="Discovery map">
            <DockPanel Margin="24,20,24,24">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Discovery map" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Everything the run found, where it came from and what was checked on it." Style="{StaticResource PageSub}" Margin="0,2,0,0"/>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5*" MinWidth="420"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="640"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" ClipToBounds="True">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,0,16,0" Height="48" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
                      <DockPanel>
                        <TextBlock x:Name="TxtMapCount" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Button x:Name="BtnExpandAll" Style="{StaticResource SubtleButton}" ToolTip="Open every branch of the tree">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE70D;" FontSize="12"/><TextBlock Text="Expand all"/></StackPanel>
                          </Button>
                          <Button x:Name="BtnCollapseAll" Style="{StaticResource SubtleButton}" Margin="4,0,0,0" ToolTip="Close every branch except the first level">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE70E;" FontSize="12"/><TextBlock Text="Collapse all"/></StackPanel>
                          </Button>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <TreeView x:Name="MapTree" ItemTemplate="{StaticResource MapNode}" AutomationProperties.Name="Discovery map">
                      <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                          <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=OneTime}"/>
                        </Style>
                      </TreeView.ItemContainerStyle>
                    </TreeView>
                  </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"/>
                <Border Grid.Column="2" Style="{StaticResource Panel}" ClipToBounds="True">
                  <ContentControl x:Name="MapHost" Style="{StaticResource PaneHost}"/>
                </Border>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- Run log -->
          <TabItem x:Name="TabLog" Header="Run log">
            <DockPanel Margin="24,20,24,24">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Run log" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="What the run did, step by step. It fills in live while a run is in progress." Style="{StaticResource PageSub}" Margin="0,2,0,0"/>
              </StackPanel>
              <Border Style="{StaticResource Panel}" ClipToBounds="True">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="16,8" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <TextBlock x:Name="TxtLogCount" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                      <WrapPanel>
                        <TextBox x:Name="FltLog" Style="{StaticResource SearchBox}" Width="300" Tag="Filter the log (Ctrl+F)" Margin="0,4,16,4" AutomationProperties.Name="Filter the log"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,16,4">
                          <TextBlock Text="Level" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <ComboBox x:Name="FltLogLevel" Width="168" AutomationProperties.Name="Log level filter"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkFollow" Content="Auto-scroll to the newest line" IsChecked="True" VerticalAlignment="Center" Margin="0,4,16,4"/>
                        <Button x:Name="BtnCopyLog" Style="{StaticResource SubtleButton}" Margin="0,4,0,4" ToolTip="Copy the lines that are shown to the clipboard">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE8C8;" FontSize="14"/><TextBlock Text="Copy shown lines"/></StackPanel>
                        </Button>
                      </WrapPanel>
                    </DockPanel>
                  </Border>
                  <Grid>
                    <ListBox x:Name="LogList" ItemTemplate="{StaticResource LogRow}" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Run log"/>
                    <StackPanel Visibility="{Binding Visibility, ElementName=TxtLogEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
                      <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource B.Hover}" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D5;" FontSize="24" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock x:Name="TxtLogEmpty" Style="{StaticResource Muted}" TextAlignment="Center" Text="The log fills in while a run is in progress."/>
                    </StackPanel>
                  </Grid>
                </DockPanel>
              </Border>
            </DockPanel>
          </TabItem>

          <!-- Objects: every object of the graph, with search and a type filter; the right pane opens one object. -->
          <TabItem x:Name="TabObjects" Header="Objects">
            <DockPanel Margin="24,20,24,24">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Objects" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Everything the run found: where each object exists, where it is missing, and how the objects are linked." Style="{StaticResource PageSub}" Margin="0,2,0,0"/>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5*" MinWidth="420"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="640"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" ClipToBounds="True">
                  <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14,16,6" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="640"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBox x:Name="FltObj" Style="{StaticResource SearchBox}" Tag="Search name, URL or id (Ctrl+F)" ToolTip="Type words; an object must contain every word in its name, id or type." AutomationProperties.Name="Search objects"/>
                        </Grid>
                        <WrapPanel>
                          <ComboBox x:Name="FltObjType" Style="{StaticResource FilterCombo}" Tag="Type" Width="240" Margin="0,0,16,8" AutomationProperties.Name="Object type filter"/>
                          <CheckBox x:Name="ChkObjAttention" Content="Only objects that need attention" VerticalAlignment="Center" Margin="0,0,0,8" ToolTip="Objects with a finding worse than Information, or missing from a place where they are expected"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource B.Divider}" BorderThickness="0,1,0,0" Padding="16,0,8,0" Height="44">
                      <DockPanel>
                        <Button x:Name="BtnObjClear" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" VerticalAlignment="Center" ToolTip="Remove the search and the filters">
                          <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CmdGlyph}" Text="&#xE894;" FontSize="14"/><TextBlock Text="Clear filters"/></StackPanel>
                        </Button>
                        <TextBlock x:Name="TxtObjShowing" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                      </DockPanel>
                    </Border>
                    <Grid>
                      <ListBox x:Name="ObjList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" AutomationProperties.Name="Objects">
                        <ListBox.GroupStyle>
                          <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                              <DataTemplate>
                                <Border Padding="16,12,16,4">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="9" Background="#E0E0E0" Padding="7,0" Height="18" Margin="8,0,0,0" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                          </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Height="44">
                              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <ContentPresenter Content="{Binding MissingPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                                <ContentPresenter Content="{Binding FindingPill}" ContentTemplate="{StaticResource PillTemplate}"/>
                              </StackPanel>
                              <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="4" Background="{StaticResource B.AccentSoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center"/>
                              </Border>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                <TextBlock Text="{Binding Id}" Style="{StaticResource Small}" FontFamily="{StaticResource F.Mono}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
                              </StackPanel>
                            </DockPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <StackPanel Visibility="{Binding Visibility, ElementName=TxtObjEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource B.Hover}" HorizontalAlignment="Center" Margin="0,0,0,14">
                          <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" FontSize="24" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtObjEmpty" Visibility="Collapsed" Style="{StaticResource Muted}" TextAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </DockPanel>
                </Border>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"/>
                <Border Grid.Column="2" Style="{StaticResource Panel}" ClipToBounds="True">
                  <ContentControl x:Name="ObjHost" Style="{StaticResource PaneHost}"/>
                </Border>
              </Grid>
            </DockPanel>
          </TabItem>

          <!-- PKI services: Web Enrollment, CES, CEP, NDES/SCEP, OCSP and the Intune Certificate Connector. -->
          <TabItem x:Name="TabServices" Header="PKI services">
            <DockPanel Margin="24,20,24,24">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="PKI services" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Enrollment and revocation services: what was found, what is not there, and what cannot be checked from this computer." Style="{StaticResource PageSub}" Margin="0,2,0,0"/>
              </StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5*" MinWidth="420"/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="640"/>
                </Grid.ColumnDefinitions>
                <Grid>
                  <ScrollViewer x:Name="SvcScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                      <TextBlock x:Name="TxtSvcSummary" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                      <ItemsControl x:Name="SvcList" ItemTemplate="{StaticResource ServiceCard}" Focusable="False" AutomationProperties.Name="PKI services"/>
                    </StackPanel>
                  </ScrollViewer>
                  <Border Style="{StaticResource Panel}" Visibility="{Binding Visibility, ElementName=TxtSvcEmpty}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
                      <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource B.Hover}" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE912;" FontSize="24" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
                      </Border>
                      <TextBlock x:Name="TxtSvcEmpty" Style="{StaticResource Muted}" TextAlignment="Center" Text="There are no results yet. Run a health check, or open an earlier results.json."/>
                    </StackPanel>
                  </Border>
                </Grid>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False"/>
                <Border Grid.Column="2" Style="{StaticResource Panel}" ClipToBounds="True">
                  <ContentControl x:Name="SvcHost" Style="{StaticResource PaneHost}"/>
                </Border>
              </Grid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>

      <!-- ===== Status bar ===== -->
      <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Height="30" Padding="16,0">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,16,0">
            <TextBlock x:Name="StatusIcon" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtStage" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="TxtTarget" Grid.Column="1" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TxtElapsed}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtElapsed" Style="{StaticResource Small}" VerticalAlignment="Center" Text="Elapsed 0:00"/>
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtCount" Style="{StaticResource Small}" VerticalAlignment="Center" Text="0 findings"/>
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="12" Foreground="{StaticResource B.Muted}" Margin="0,0,6,0"/>
            <TextBlock x:Name="TxtOutputPath" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
