  <SolidColorBrush x:Key="B.BadLine" Color="#EEACB2"/>
  <SolidColorBrush x:Key="B.InfoBack" Color="#EBF3FC"/>
  <SolidColorBrush x:Key="B.InfoFore" Color="#0F548C"/>
  <SolidColorBrush x:Key="B.InfoLine" Color="#B4D6FA"/>
  <SolidColorBrush x:Key="B.AdminBack" Color="#F7F4FB"/>
  <SolidColorBrush x:Key="B.AdminFore" Color="#5C2E91"/>
  <SolidColorBrush x:Key="B.AdminLine" Color="#C6B1DE"/>
  <SolidColorBrush x:Key="B.NeutralBack" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="B.NeutralFore" Color="#424242"/>
  <SolidColorBrush x:Key="B.NeutralLine" Color="#D1D1D1"/>
  <SolidColorBrush x:Key="B.OnAccent" Color="#FFFFFF"/>
  <!-- Data colours (score ring, area bars): mid tones with at least 3:1 against the white card, so a bar reads without its label. -->
  <SolidColorBrush x:Key="B.GoodData" Color="#107C10"/>
  <SolidColorBrush x:Key="B.WarnData" Color="#C27C0E"/>
  <SolidColorBrush x:Key="B.BadData" Color="#D13438"/>
  <SolidColorBrush x:Key="B.AdminData" Color="#8764B8"/>
  <SolidColorBrush x:Key="B.NeutralData" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="B.InfoData" Color="#0F6CBD"/>
  <SolidColorBrush x:Key="B.OnHeader" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.OnData" Color="#FFFFFF"/>
  <!-- Focus ring, hover lines, scroll bars, check boxes, navigation selection, count badges, header outlines. -->
  <SolidColorBrush x:Key="B.FocusRing" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="B.FocusRingInner" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="B.HoverLine" Color="#C7C7C7"/>
  <SolidColorBrush x:Key="B.CloseHoverPressed" Color="#A52317"/>
  <SolidColorBrush x:Key="B.FieldHover" Color="#FCFCFC"/>
  <SolidColorBrush x:Key="B.Scroll" Color="#C2C2C2"/>
  <SolidColorBrush x:Key="B.ScrollHover" Color="#9E9E9E"/>
  <SolidColorBrush x:Key="B.ScrollDrag" Color="#757575"/>
  <SolidColorBrush x:Key="B.ControlStrong" Color="#616161"/>
  <SolidColorBrush x:Key="B.NavSelect" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="B.Badge" Color="#E0E0E0"/>
  <SolidColorBrush x:Key="B.HeaderLine" Color="#4A5160"/>
</ResourceDictionary>